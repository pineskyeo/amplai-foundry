  "draft": {
    "acceptance": [
      {
        "statement": "tests/v3의 CLI 테스트가 `amplai ops version`을 실행해 성공적으로 JSON을 파싱하고, `python_version` 필드가 존재하며 `platform.python_version()`과 같음을 검증하고 통과한다.",
        "verifier": "unit"
      },
      {
        "statement": "변경된 Python 소스와 테스트가 Ruff lint를 통과한다.",
        "verifier": "lint"
      },
      {
        "statement": "변경된 CLI 구현이 strict mypy 검사를 통과한다.",
        "verifier": "types"
      }
    ],
    "assumptions": [
      "기존 CLI 계약 테스트에 assertion을 추가하는 것이 별도 테스트 함수를 만드는 것보다 현재 테스트 배치와 의도에 부합한다.",
      "`python_version`은 패치 수준까지 포함하는 `platform.python_version()`의 문자열을 그대로 반환한다."
    ],
    "constraints": [
      "파일 변경은 지정된 CLI 구현과 tests/v3의 관련 테스트로 제한한다.",
      "Python 버전은 별도 파싱이나 상수화 없이 실행 중 인터프리터의 `platform.python_version()`을 source of truth로 사용한다.",
      "기존 JSON 출력 형식과 기존 필드에 대한 호환성을 유지한다.",
      "Python 표준 라이브러리만 사용한다."
    ],
    "in_scope": [
      "src/amplai_foundry/runtime/cli.py의 `ops version` 출력 payload 및 필요한 표준 라이브러리 import",
      "tests/v3/test_dev01_contracts_planning.py의 기존 `test_dev01_cli_reports_development_not_final` CLI 계약 테스트"
    ],
    "non_goals": [
      "기존 `package_version`, `stage`, `schema_version`, `release_status`, `production_release` 필드의 값이나 의미 변경",
      "다른 CLI 명령, API 응답, 런타임 프로파일의 Python 버전 처리 변경",
      "새 의존성, 스키마, 데이터 저장 또는 마이그레이션 추가",
      "문서 및 canonical Vault 변경"
    ],
    "objective": "`amplai ops version` 명령의 JSON 출력에 `platform.python_version()` 값과 동일한 `python_version` 필드를 추가하고, tests/v3에서 필드의 존재와 값의 일치를 검증한다.",
    "questions": [],
    "risk": "low",
    "summary": "`amplai ops version` JSON에 실행 중인 Python 버전을 노출하고 회귀 테스트로 고정합니다."
  },

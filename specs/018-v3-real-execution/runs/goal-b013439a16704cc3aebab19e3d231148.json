  "created_at": "2026-09-27T19:56:06.676433Z",
  "decision_ref": {
    "digest": "sha256:817196416151290ded594cf743a5b9797e49537f116d52864694a201944c75ee",
    "id": "approval-8edf058d9ce14b05b02e7132d913b9c6",
    "revision": 1
  },
  "draft": {
    "acceptance": [
      {
        "statement": "`tests/v3` 테스트가 절대경로와 `..` 구성요소가 포함된 경로를 `WorkspaceManager.path`에 전달했을 때 `Hold`가 발생함을 증명한다.",
        "verifier": "unit"
      },
      {
        "statement": "`tests/v3` 테스트가 점으로 시작하는 경로 구성요소를 `WorkspaceManager.path`에 전달했을 때 `Hold`가 발생함을 증명한다.",
        "verifier": "unit"
      },
      {
        "statement": "`tests/v3` 테스트가 `.pem` 및 `.key` 확장자 경로를 `WorkspaceManager.path`에 전달했을 때 각각 `Hold`가 발생함을 증명한다.",
        "verifier": "unit"
      },
      {
        "statement": "`tests/v3` 테스트가 정상 상대경로 `a/b.txt`를 전달했을 때 같은 문자열이 반환됨을 증명한다.",
        "verifier": "unit"
      },
      {
        "statement": "변경된 테스트 코드에 Ruff lint 오류가 없다.",
        "verifier": "lint"
      }
    ],
    "assumptions": [
      "기존 관련 테스트가 위치한 `tests/v3/test_dev02_sessions_workspace.py`가 이번 단위 테스트의 적절한 소유 파일이다.",
      "숨김 경로는 현재 구현 계약대로 어느 경로 구성요소든 `.`으로 시작하는 경우를 의미한다."
    ],
    "constraints": [
      "테스트는 기존 `tests/v3/test_dev02_sessions_workspace.py`의 `WorkspaceManager` 및 `Hold` import를 재사용한다.",
      "거부 사례는 상위 예외인 `RuntimeFault`가 아니라 요구된 구체 예외 `Hold`를 검증한다.",
      "기존 관련 테스트의 추가 보안 사례는 보존하며 중복은 작은 매개변수화 테스트로 정리한다.",
      "제품 코드와 공식 지식·문서는 수정하지 않는다."
    ],
    "in_scope": [
      "`tests/v3/test_dev02_sessions_workspace.py`의 기존 workspace path 테스트를 `Hold` 계약에 맞게 보강한다.",
      "절대경로, `..` 포함 경로, 점으로 시작하는 경로 구성요소, `.pem`·`.key` 확장자를 대표하는 입력을 매개변수화해 검증한다.",
      "`WorkspaceManager.path(\"a/b.txt\") == \"a/b.txt\"`인 정상 경로 테스트를 추가한다."
    ],
    "non_goals": [
      "`src/amplai_foundry/sandbox/workspace.py`의 구현이나 경로 정책을 변경하지 않는다.",
      "`.p12`, `.pfx`, 역슬래시, NUL, 중복 구분자 등 운영자 목표 밖의 기존 경로 정책을 확대하거나 축소하지 않는다.",
      "workspace snapshot, materialize, collect 동작을 변경하지 않는다."
    ],
    "objective": "`tests/v3`에서 `WorkspaceManager.path`가 절대경로, `..` 경로, 숨김 경로, `.pem`·`.key` 경로를 `Hold`로 거부하고 정상 상대경로 `a/b.txt`는 변경 없이 반환하는지 검증한다.",
    "questions": [],
    "risk": "low",
    "summary": "기존 workspace 테스트를 보강해 `WorkspaceManager.path`의 허용·거부 계약을 직접 검증합니다."
  },

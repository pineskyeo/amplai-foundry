  "draft": {
    "acceptance": [
      {
        "statement": "절대경로와 `..` 세그먼트를 포함한 경로가 `WorkspaceManager.path`에서 `Hold`로 거부됨을 tests/v3가 입증한다.",
        "verifier": "unit"
      },
      {
        "statement": "경로의 어느 세그먼트든 점으로 시작하는 숨김 경로가 `Hold`로 거부됨을 tests/v3가 입증한다.",
        "verifier": "unit"
      },
      {
        "statement": "`.pem` 또는 `.key`로 끝나는 경로가 `Hold`로 거부됨을 tests/v3가 입증한다.",
        "verifier": "unit"
      },
      {
        "statement": "정상 상대경로 `a/b.txt`가 변경 없이 그대로 반환됨을 tests/v3가 입증한다.",
        "verifier": "unit"
      },
      {
        "statement": "테스트 변경 후 Ruff lint가 깨끗하다.",
        "verifier": "lint"
      },
      {
        "statement": "테스트 변경 후 mypy strict type check가 깨끗하다.",
        "verifier": "types"
      }
    ],
    "assumptions": [
      "기존 `tests/v3/test_dev02_sessions_workspace.py`가 `WorkspaceManager` 경로 계약 테스트의 적절한 소유 파일이다.",
      "현재 구현에서 `Hold`는 `RuntimeFault`의 하위 클래스이므로 기존 `pytest.raises(RuntimeFault)` 검사는 요구된 구체적 계약을 충분히 고정하지 못한다."
    ],
    "constraints": [
      "제품 코드는 수정하지 않고 tests/v3의 관련 테스트만 변경",
      "거부 사례는 상위 예외인 `RuntimeFault`가 아니라 구체적인 `Hold` 발생을 검증",
      "기존 테스트 파일의 pytest 관례와 import를 재사용",
      "완료 전 lint, strict type check, tests/v3 검증을 각각 실행하고 실패를 숨기지 않음"
    ],
    "in_scope": [
      "tests/v3/test_dev02_sessions_workspace.py의 기존 `test_dev02_workspace_paths_reject_control_and_secrets`를 `Hold` 계약에 맞게 수정",
      "tests/v3/test_dev02_sessions_workspace.py에 `WorkspaceManager.path(\"a/b.txt\") == \"a/b.txt\"` 성공 사례 추가"
    ],
    "non_goals": [
      "src/amplai_foundry/sandbox/workspace.py의 구현 또는 경로 정책 변경",
      "요청에 없는 확장자나 경로 형식의 동작 변경",
      "다른 sandbox·workspace 기능 테스트의 재구성"
    ],
    "objective": "`WorkspaceManager.path`가 절대경로, `..` 세그먼트 포함 경로, 점으로 시작하는 숨김 경로, `.pem`·`.key` 경로를 `Hold`로 거부하고 정상 상대경로 `a/b.txt`는 변경 없이 반환하는지 `tests/v3`에서 검증합니다.",
    "questions": [],
    "risk": "low",
    "summary": "기존 workspace 경로 테스트를 정확한 Hold 계약과 정상 반환 사례까지 보강합니다."
  },

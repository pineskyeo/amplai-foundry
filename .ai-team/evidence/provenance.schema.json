{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:amplai:provenance:1",
  "type": "object",
  "required": ["id", "status", "statement", "evidence"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "active", "deprecated", "superseded", "rejected"]},
    "statement": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": {"type": "string"},
          "path": {"type": "string"},
          "locator": {"type": "string"},
          "sha256": {"type": "string"}
        }
      }
    },
    "verified_at_commit": {"type": "string"},
    "introduced_by_work": {"type": "string"},
    "supersedes": {"type": "string"},
    "superseded_by": {"type": "string"}
  }
}

{
  "schema_version": "1.0",
  "actions": {
    "read_repo": {"level": "allowed", "reason": "repository 내부 읽기"},
    "edit_repo": {"level": "allowed", "reason": "contract scope 안의 repository 수정"},
    "run_test": {"level": "allowed", "reason": "test/build/lint/verifier 실행"},
    "git_diff": {"level": "allowed", "reason": "상태와 diff 확인"},
    "architecture_change": {"level": "gated", "gate": "architecture_change"},
    "public_contract_change": {"level": "gated", "gate": "public_contract"},
    "ontology_promotion": {"level": "gated", "gate": "ontology_promotion"},
    "destructive_migration": {"level": "gated", "gate": "destructive_change"},
    "production_operation": {"level": "gated", "gate": "production_operation"},
    "commit": {"level": "gated", "gate": "git_publish"},
    "push": {"level": "prohibited", "reason": "명시 승인 없는 remote publish 금지"},
    "merge": {"level": "prohibited", "reason": "명시 승인 없는 merge 금지"},
    "release": {"level": "prohibited", "reason": "명시 승인 없는 release 금지"},
    "deploy": {"level": "prohibited", "reason": "명시 승인 없는 production deploy 금지"},
    "secret_disclosure": {"level": "prohibited", "reason": "secret/private value 출력 금지"}
  }
}

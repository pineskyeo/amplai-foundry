      "*>*",
      "*{*",
      "*}*",
      "*$*",
      "*...*",
      "*|*",
      "http:*",
      "https:*",
      "~*",
      "/*",
      "*NN*",
      "*PATH*",
      "*FEATURE*",
      "*name*",
      "epoko77-ai/*"
    ],
    "known_absent": [
      ".specify/eval/**",
      ".specify/eval/",
      "_workspace/**",
      "_workspace/",
      "bin/**",
      "bin/",
      "build/**",
      "build/",
      "dist/**",
      "dist/",
      "rpmbuild/**",
      "rpmbuild/",
      "lib/**",

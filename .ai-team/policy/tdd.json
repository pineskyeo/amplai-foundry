{
  "schema_version": "1.0",
  "work_types": {
    "bug_fix": {
      "regression_test_first": "required",
      "evidence_sequence": ["RED", "FIX", "GREEN", "REGRESSION"]
    },
    "logic_change": {
      "test_first": "preferred"
    },
    "refactor": {
      "characterization_test_first": "preferred_or_required"
    },
    "new_feature": {
      "acceptance_test_first": "preferred"
    },
    "hardware_config_deploy": {
      "tdd": "optional",
      "integration_or_operational_verifier": "required_when_applicable"
    }
  },
  "rule": "별도 /tdd command를 만들지 않고 /work와 dev-loop의 verifier 정책으로 적용한다."
}

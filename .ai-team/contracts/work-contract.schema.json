{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:amplai:work-contract:2",
  "title": "AMPLAI Work Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "goal",
    "risk",
    "scope",
    "acceptance",
    "verification",
    "retry",
    "status"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "2.0"]},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "goal": {"type": "string", "minLength": 1},
    "source": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "work_type": {
      "enum": [
        "tiny_change",
        "bug_fix",
        "logic_change",
        "refactor",
        "new_feature",
        "domain_heavy",
        "architecture",
        "operations"
      ]
    },
    "risk": {"enum": ["low", "normal", "high"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {"type": "array", "items": {"type": "string"}},
        "exclude": {"type": "array", "items": {"type": "string"}}
      }
    },
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness", "context_pack", "domain_discovery"],
      "properties": {
        "readiness": {"enum": ["bypass", "optional", "required"]},
        "readiness_file": {"type": "string"},
        "context_pack": {"enum": ["optional", "required"]},
        "context_pack_file": {"type": "string"},
        "domain_discovery": {"enum": ["optional", "required_if_not_ready"]},
        "domain_discovery_file": {"type": "string"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {
          "enum": ["fast", "standard", "runtime", "semantic", "v2", "full", "rhel"]
        },
        "operational": {"type": "array", "items": {"type": "string"}}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint"],
      "properties": {
        "fingerprint": {"enum": ["optional", "required"]},
        "fingerprint_file": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_trace"],
      "properties": {
        "evidence_trace": {"enum": ["optional", "required"]},
        "trace_file": {"type": "string"}
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "enum": [
          "requirement_decision",
          "architecture_change",
          "public_contract",
          "ontology_promotion",
          "destructive_change",
          "production_operation",
          "git_publish"
        ]
      },
      "uniqueItems": true
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts_per_slice"],
      "properties": {
        "max_attempts_per_slice": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "decisions": {"type": "array", "items": {"type": "string"}},
    "blocked_by": {"type": "array", "items": {"type": "string"}},
    "status": {
      "enum": ["draft", "discovering", "awaiting_approval", "ready", "executing", "blocked", "done"]
    }
  }
}

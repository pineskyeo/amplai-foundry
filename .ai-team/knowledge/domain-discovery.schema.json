{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:amplai:domain-discovery:1",
  "type": "object",
  "required": [
    "schema_version",
    "work_id",
    "terms",
    "evidence_candidates",
    "known_facts",
    "invariants",
    "contradictions",
    "unknowns",
    "blocking_questions",
    "generated_from"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "work_id": {"type": "string"},
    "terms": {"type": "array", "items": {"type": "string"}},
    "evidence_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "score", "matches"],
        "properties": {
          "path": {"type": "string"},
          "score": {"type": "number"},
          "matches": {"type": "array", "items": {"type": "string"}},
          "locators": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "known_facts": {"type": "array", "items": {"type": "object"}},
    "invariants": {"type": "array", "items": {"type": "object"}},
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "blocking_questions": {"type": "array", "items": {"type": "string"}},
    "generated_from": {"type": "object"}
  }
}

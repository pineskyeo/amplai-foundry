{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:amplai:context-pack:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "goal",
    "knowledge_verdict",
    "required_knowledge",
    "active_decisions",
    "ontology_refs",
    "code_scope",
    "test_scope",
    "verifier_profile",
    "unknowns",
    "generated_from",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "work_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "knowledge_verdict": {"enum": ["READY", "BYPASS"]},
    "required_knowledge": {"type": "array", "items": {"$ref": "#/definitions/ref"}},
    "active_decisions": {"type": "array", "items": {"$ref": "#/definitions/ref"}},
    "ontology_refs": {"type": "array", "items": {"$ref": "#/definitions/ref"}},
    "code_scope": {"type": "array", "items": {"type": "string"}},
    "test_scope": {"type": "array", "items": {"type": "string"}},
    "verifier_profile": {"type": "string"},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "generated_from": {
      "type": "object",
      "required": ["commit", "contract_sha256", "knowledge_map_sha256", "claims_sha256"],
      "properties": {
        "commit": {"type": "string"},
        "contract_sha256": {"type": "string"},
        "knowledge_map_sha256": {"type": "string"},
        "claims_sha256": {"type": "string"},
        "readiness_sha256": {"type": "string"},
        "discovery_sha256": {"type": "string"}
      }
    },
    "content_hash": {"type": "string", "minLength": 64, "maxLength": 64}
  },
  "definitions": {
    "ref": {
      "type": "object",
      "required": ["id", "status", "path"],
      "properties": {
        "id": {"type": "string"},
        "status": {"type": "string"},
        "path": {"type": "string"},
        "reason": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}

{
  "schema_version": "2.0",
  "runtime": "amplai-loop-v2",
  "public_commands": ["work", "design"],
  "defaults": {
    "risk": "normal",
    "profile": "standard",
    "max_repair_attempts": 3,
    "contract_required": ["normal", "high"],
    "knowledge_readiness_required_for": ["domain_heavy", "architecture", "operations", "repository_gardening", "high-risk"],
    "documentation_freshness_required_for": ["normal", "high"],
    "incremental_gardening_required_for": ["normal", "high"],
    "full_gardening_only_for": ["repository_gardening"],
    "context_pack_required": ["normal", "high"],
    "environment_fingerprint_required": ["normal", "high"],
    "evidence_trace_required": ["normal", "high"],
    "review_required": ["normal", "high"]
  },
  "risk_rank": {"low": 0, "normal": 1, "high": 2},
  "profile_rank": {
    "fast": 0,
    "commit": 1,
    "standard": 2,
    "runtime": 3,
    "full": 4,
    "v2": 5
  },
  "risk_profiles": {"low": "fast", "normal": "standard", "high": "standard"},
  "human_gates": {
    "requirement_decision": "요구 자체의 의미·우선순위·충돌을 사람이 결정해야 한다.",
    "architecture_change": "큰 구조 또는 ownership boundary를 바꾼다.",
    "public_contract": "API/schema/registry/파일 형식/ABI 호환성에 영향을 준다.",
    "ontology_promotion": "candidate knowledge를 canonical active ontology로 승격한다.",
    "destructive_change": "데이터·파일·기능 삭제 또는 되돌리기 어려운 migration이다.",
    "production_operation": "설비·운영 환경에 설치, 실행, 변경한다.",
    "git_publish": "commit/push/PR/merge/release 등 저장소 밖 상태를 바꾼다."
  },
  "path_rules": [
    {
      "id": "loop-runtime-v2",
      "patterns": [
        "AGENTS.md", "CLAUDE.md", "CODEX.md", ".claude/settings.json",
        ".codex/config.toml", ".mcp.json", ".ai-team/README.md",
        ".ai-team/runtime/**", ".ai-team/policy/**", ".ai-team/contracts/**",
        ".ai-team/verifiers/**", ".ai-team/knowledge/**", ".ai-team/evidence/**",
        ".ai-team/rules/**", ".agents/skills/work/**", ".agents/skills/design/**",
        ".agents/skills/dev-loop/**", ".agents/skills/speckit-*/**",
        ".agents/skills/taskify/**", ".agents/skills/code-review/**",
        ".agents/skills/systematic-debugging/**", ".claude/skills/**",
        ".specify/memory/constitution.md", ".specify/scripts/**", ".specify/templates/**",
        "scripts/eval.sh", "scripts/loopctl.py", "scripts/loopv2.py",
        ".github/workflows/**"
      ],
      "risk": "high",
      "profile": "v2",
      "gates": ["architecture_change"]
    },
    {
      "id": "public-contract",
      "patterns": ["schemas/**"],
      "risk": "high",
      "profile": "full",
      "gates": ["public_contract"]
    },
    {
      "id": "feature-artifacts",
      "patterns": ["specs/**"],
      "risk": "normal",
      "profile": "standard",
      "gates": []
    },
    {
      "id": "code-and-tests",
      "patterns": ["src/**", "tests/**", "scripts/**", "pyproject.toml"],
      "risk": "normal",
      "profile": "standard",
      "gates": []
    },
    {
      "id": "documentation-only",
      "patterns": ["README.md", "docs/**"],
      "risk": "low",
      "profile": "fast",
      "gates": []
    },
    {
      "gates": [
        "architecture_change"
      ],
      "id": "amplai-decision-async-runtime",
      "patterns": [
        "scripts/amplai.py",
        "scripts/amplai_runtime.py",
        "scripts/amplai_supervisor.py",
        "scripts/amplai_hook.py",
        ".ai-team/runtime/async-policy.json",
        ".ai-team/runtime/schemas/**",
        ".ai-team/runtime/DECISION_ASYNC_PROTOCOL.md",
        ".ai-team/runtime/LOCAL_SUPERVISOR.md",
        ".ai-team/runtime/INSTALLATION.md",
        "tools/amplai-loop-kit/**",
        "tests/ai/test_amplai_async_runtime.py",
        "tests/ai/test_amplai_kit_installer.py",
        "tests/ai/test_amplai_kit_regressions.py"
      ],
      "profile": "v2",
      "risk": "high"
    }
  ],
  "review_triggers": [
    "risk is normal or high",
    "Knowledge Readiness conflict or superseded knowledge was resolved",
    "security/privacy/secret handling changes",
    "public contract, ontology canonical model, or production path changes",
    "memory ownership/concurrency/error recovery changes",
    "verifier/runtime/policy/permission changes"
  ],
  "forbidden_automatic_actions": [
    "code while Knowledge Readiness is DISCOVER or BLOCKED",
    "silently choose between contradictory active knowledge sources",
    "promote ontology candidates without validation and human/governor approval",
    "change an unresolved requirement",
    "delete or migrate production data",
    "deploy to equipment or production",
    "commit, push, open or merge a PR, or release without explicit request",
    "silently weaken a verifier to obtain PASS",
    "delete a HUMAN_GATED gardening candidate without explicit human approval",
    "call code dead because no static text reference was found",
    "run full repository gardening outside an explicit repository_gardening Work",
    "declare DONE while documentation freshness is STALE",
    "overwrite a historical decision to match current behavior",
    "implement V3 parallel worker or scheduler features in V2",
    "let the Local Supervisor invent goals, affected apps, architecture, or contracts",
    "treat a rendered handoff as canonical state",
    "auto-run DRAFT, BLOCKED, HUMAN_REQUIRED, FAILED, DONE, or CANCELLED cross-app Work"
  ]
}

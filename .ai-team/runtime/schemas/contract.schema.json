{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amplai.local/schemas/contract.schema.json",
  "title": "AMPLAI Cross-App Contract Reference",
  "type": "object",
  "required": ["schema_version", "kind", "contract_ref", "contract_id", "version", "contract_kind", "producer_apps", "consumer_apps", "source_ref", "compatibility", "status", "verification", "created_at", "updated_at", "content_hash"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "contract"},
    "contract_ref": {"type": "string", "pattern": "^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+$"},
    "contract_id": {"type": "string"},
    "version": {"type": "string"},
    "contract_kind": {"type": "string"},
    "producer_apps": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "consumer_apps": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "source_ref": {"type": "string", "minLength": 1},
    "compatibility": {"enum": ["BACKWARD", "FORWARD", "FULL", "BREAKING", "UNKNOWN"]},
    "status": {"enum": ["DRAFT", "ACTIVE", "DEPRECATED", "SUPERSEDED"]},
    "verification": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "content_hash": {"type": "string"}
  },
  "additionalProperties": false
}

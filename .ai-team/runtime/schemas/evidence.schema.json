{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amplai.local/schemas/evidence.schema.json",
  "title": "AMPLAI Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "evidence_id",
    "change_id",
    "evidence_type",
    "summary",
    "source",
    "facts",
    "metadata",
    "created_by",
    "created_at",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "evidence"
    },
    "evidence_id": {
      "type": "string"
    },
    "change_id": {
      "type": "string"
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_type": {
      "enum": [
        "code",
        "test",
        "runtime",
        "documentation",
        "git",
        "web",
        "benchmark",
        "contract",
        "review",
        "human_approval",
        "artifact",
        "other"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "locator",
        "observed_at"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object"
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "federation": {
      "type": "object",
      "required": [
        "scope",
        "origin",
        "promotion_status",
        "submission_id",
        "canonical_ref",
        "submitted_at",
        "resolved_at",
        "rejection_reason"
      ],
      "properties": {
        "scope": {
          "const": "local"
        },
        "origin": {
          "type": "object",
          "required": [
            "store",
            "project_id",
            "object_ref"
          ],
          "properties": {
            "store": {
              "const": "amplai-project-store"
            },
            "project_id": {
              "type": "string"
            },
            "object_ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "promotion_status": {
          "enum": [
            "LOCAL",
            "CANDIDATE",
            "SUBMITTED",
            "ACCEPTED",
            "REJECTED"
          ]
        },
        "submission_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "submitted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "rejection_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

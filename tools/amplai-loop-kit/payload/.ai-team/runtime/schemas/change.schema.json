{
  "$id": "https://amplai.local/schemas/change.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "affected_apps": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "change_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "contract_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "created_at": {
      "type": "string"
    },
    "decision_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "goal": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "const": "change"
    },
    "question_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_app": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "WAITING",
        "BLOCKED",
        "HUMAN_REQUIRED",
        "DONE",
        "CANCELLED"
      ]
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "work_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "kind",
    "change_id",
    "title",
    "goal",
    "status",
    "source_app",
    "affected_apps",
    "contract_refs",
    "work_refs",
    "question_refs",
    "decision_refs",
    "evidence_refs",
    "created_at",
    "updated_at",
    "content_hash"
  ],
  "title": "AMPLAI Cross-App Change Request",
  "type": "object"
}

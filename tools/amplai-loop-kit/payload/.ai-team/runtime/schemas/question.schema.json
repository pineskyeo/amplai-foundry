{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amplai.local/schemas/question.schema.json",
  "title": "AMPLAI Open Question",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "question_id",
    "change_id",
    "work_id",
    "question",
    "decision_class",
    "reversibility",
    "blast_radius",
    "required_authority",
    "policy_minimum_authority",
    "evidence_plan",
    "evidence_refs",
    "alternatives",
    "status",
    "created_at",
    "updated_at",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "question"
    },
    "question_id": {
      "type": "string"
    },
    "change_id": {
      "type": "string"
    },
    "work_id": {
      "type": "string"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "decision_class": {
      "enum": [
        "engineering",
        "architecture",
        "compatibility",
        "persistence",
        "performance_architecture",
        "cross_app_contract",
        "public_contract",
        "domain",
        "product",
        "production",
        "safety",
        "security",
        "privacy",
        "legal",
        "destructive",
        "unknown"
      ]
    },
    "reversibility": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "blast_radius": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "required_authority": {
      "enum": [
        "AUTO",
        "CHALLENGE",
        "HUMAN"
      ]
    },
    "policy_minimum_authority": {
      "enum": [
        "AUTO",
        "CHALLENGE",
        "HUMAN"
      ]
    },
    "evidence_plan": {
      "type": "object",
      "required": [
        "mode",
        "lanes"
      ],
      "properties": {
        "mode": {
          "enum": [
            "DIRECT",
            "LOCAL",
            "PARALLEL"
          ]
        },
        "lanes": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "name",
              "goal"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "goal": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "OPEN",
        "RESOLVED",
        "DEFERRED",
        "CANCELLED"
      ]
    },
    "resolution_decision_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_trigger": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

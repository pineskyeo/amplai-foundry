{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amplai.local/schemas/project.schema.json",
  "title": "AMPLAI Project Store Identity",
  "type": "object",
  "required": ["schema_version", "kind", "runtime_protocol", "project_id", "name", "created_at", "updated_at", "content_hash"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "project"},
    "runtime_protocol": {"const": "amplai.async-cross-app.v1"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

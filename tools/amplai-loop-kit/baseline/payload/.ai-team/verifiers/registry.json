{
  "schema_version": "2.0",
  "project": "generic",
  "profiles": {
    "fast": {
      "description": "Mandatory generic runtime checks; no product readiness claim",
      "checks": [
        "loop-runtime-doctor",
        "portable-runtime",
        "loop-shell-syntax"
      ]
    },
    "commit": {
      "extends": [
        "fast"
      ],
      "checks": [
        "diff-check"
      ]
    },
    "standard": {
      "extends": [
        "fast"
      ],
      "checks": [
        "portable-tasks"
      ]
    },
    "runtime": {
      "extends": [
        "standard"
      ],
      "checks": []
    },
    "full": {
      "extends": [
        "standard"
      ],
      "checks": []
    },
    "v2": {
      "extends": [
        "runtime",
        "full"
      ],
      "checks": []
    }
  },
  "checks": [
    {
      "id": "loop-runtime-doctor",
      "command": "python3 -I -S -B scripts/loopctl.py doctor",
      "source": ".ai-team/runtime/WORKFLOW.md",
      "severity": "block"
    },
    {
      "id": "portable-runtime",
      "command": "python3 -I -S -B .ai-team/verifiers/portable.py runtime",
      "source": ".ai-team/verifiers/portable.py",
      "severity": "block"
    },
    {
      "id": "portable-tasks",
      "command": "python3 -I -S -B .ai-team/verifiers/portable.py tasks",
      "source": ".agents/skills/taskify/SKILL.md",
      "severity": "block"
    },
    {
      "id": "loop-shell-syntax",
      "command": "python3 -I -S -B .ai-team/verifiers/portable.py shell",
      "source": ".ai-team/verifiers/portable.py",
      "severity": "block"
    },
    {
      "id": "diff-check",
      "command": "git diff --check",
      "source": "AGENTS.md",
      "severity": "block"
    }
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:amplai:knowledge-readiness:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "work_type",
    "risk",
    "checks",
    "blocking_unknowns",
    "contradictions",
    "verdict",
    "generated_from"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "work_id": {"type": "string", "minLength": 1},
    "work_type": {"type": "string"},
    "risk": {"enum": ["low", "normal", "high"]},
    "bypass_reason": {"type": "string"},
    "checks": {
      "type": "object",
      "required": [
        "terminology",
        "current_behavior",
        "system_boundary",
        "invariants",
        "source_of_truth",
        "contradictions",
        "acceptance",
        "verifier"
      ],
      "additionalProperties": false,
      "properties": {
        "terminology": {"$ref": "#/definitions/readinessCheck"},
        "current_behavior": {"$ref": "#/definitions/readinessCheck"},
        "system_boundary": {"$ref": "#/definitions/readinessCheck"},
        "invariants": {"$ref": "#/definitions/readinessCheck"},
        "source_of_truth": {"$ref": "#/definitions/readinessCheck"},
        "contradictions": {"$ref": "#/definitions/readinessCheck"},
        "acceptance": {"$ref": "#/definitions/readinessCheck"},
        "verifier": {"$ref": "#/definitions/readinessCheck"}
      }
    },
    "blocking_unknowns": {"type": "array", "items": {"type": "string"}},
    "contradictions": {"type": "array", "items": {"type": "string"}},
    "verdict": {"enum": ["READY", "DISCOVER", "BLOCKED"]},
    "generated_from": {
      "type": "object",
      "required": ["contract", "commit"],
      "properties": {
        "contract": {"type": "string"},
        "commit": {"type": "string"},
        "discovery": {"type": "string"}
      }
    }
  },
  "definitions": {
    "readinessCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["ready", "unknown", "conflict", "not_applicable"]},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:amplai:garden-report:1",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "scope",
    "applied",
    "candidates",
    "summary",
    "pass",
    "generated_from",
    "content_hash",
    "report_only",
    "scan_complete"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "enum": [
        "incremental",
        "full"
      ]
    },
    "applied": {
      "type": "boolean"
    },
    "pass": {
      "type": "boolean"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "type",
          "target",
          "reason",
          "evidence",
          "risk",
          "classification",
          "safety",
          "recommended_action",
          "status"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^G-[0-9]{3,}$"
          },
          "type": {
            "enum": [
              "generated_garbage",
              "temporary_backup",
              "prunable_worktree",
              "orphan_test_fixture",
              "obsolete_script",
              "unused_helper",
              "duplicate_fixture",
              "stale_config",
              "orphan_document",
              "broken_reference",
              "legacy_ai_artifact",
              "dead_code"
            ]
          },
          "target": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "classification": {
            "type": "object",
            "required": [
              "public_api",
              "conditional_build",
              "plugin_entry",
              "production_path"
            ],
            "properties": {
              "public_api": {
                "type": "boolean"
              },
              "conditional_build": {
                "type": "boolean"
              },
              "plugin_entry": {
                "type": "boolean"
              },
              "production_path": {
                "type": "boolean"
              }
            }
          },
          "safety": {
            "enum": [
              "SAFE_AUTO",
              "EVIDENCE_REQUIRED",
              "HUMAN_GATED"
            ]
          },
          "recommended_action": {
            "enum": [
              "delete",
              "review",
              "propose",
              "keep"
            ]
          },
          "status": {
            "enum": [
              "candidate",
              "applied",
              "gated",
              "kept"
            ]
          },
          "gate": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "by_safety",
        "applied_count",
        "gated_count"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "by_safety": {
          "type": "object"
        },
        "by_type": {
          "type": "object"
        },
        "applied_count": {
          "type": "integer"
        },
        "gated_count": {
          "type": "integer"
        }
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "all_classified": {
          "type": "boolean"
        },
        "all_have_evidence": {
          "type": "boolean"
        },
        "no_gated_auto_delete": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "applied_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "scan 상한이나 제외 규칙 때문에 보지 않은 범위를 남긴다. 조용히 잘라내지 않는다."
    },
    "generated_from": {
      "type": "object",
      "required": [
        "commit",
        "policy_sha256"
      ],
      "properties": {
        "commit": {
          "type": "string"
        },
        "worktree_state": {
          "type": "string"
        },
        "worktree_dirty": {
          "type": "boolean"
        },
        "generated_at": {
          "type": "string"
        },
        "policy_sha256": {
          "type": "string"
        }
      }
    },
    "content_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "rule": {
      "type": "string"
    },
    "report_only": {
      "const": true
    },
    "scan_complete": {
      "type": "boolean"
    }
  }
}

{
  "schema_version": "1.0",
  "offline_views": {
    "schema_version": "1.0",
    "entries": []
  },
  "portable_documents": {
    "schema_version": "1.0",
    "repository_id": "local",
    "roots": [
      "docs"
    ],
    "optional_roots": [
      "docs"
    ],
    "review_store": ".ai-team/knowledge/document-reviews.json",
    "default_security": "INTERNAL",
    "maximum_security": "INTERNAL",
    "current_release_id": null,
    "max_files": 10000,
    "max_file_bytes": 8388608,
    "max_total_bytes": 67108864,
    "governing_inputs": [
      {
        "path": "AGENTS.md",
        "role": "instruction",
        "security": "INTERNAL"
      },
      {
        "path": ".ai-team/runtime/WORKFLOW.md",
        "role": "instruction",
        "security": "INTERNAL"
      },
      {
        "path": ".ai-team/verifiers/registry.json",
        "role": "instruction",
        "security": "INTERNAL"
      }
    ]
  },
  "purpose": "언제 어떤 문서를 검사하고 update/supersede 하는지 정한다. 문서 내용은 여기 두지 않는다.",
  "canonical_roots": [
    {
      "path": "docs",
      "category": "architecture",
      "kind": "canonical"
    },
    {
      "path": "docs/workstreams",
      "category": "decision",
      "kind": "historical"
    },
    {
      "path": "docs/roadmaps/history",
      "category": "milestone_record",
      "kind": "historical"
    },
    {
      "path": ".ai-team",
      "category": "runtime_contract",
      "kind": "canonical"
    },
    {
      "path": ".specify/memory",
      "category": "runtime_design",
      "kind": "canonical"
    },
    {
      "path": "specs",
      "category": "work_memory",
      "kind": "work_scoped"
    }
  ],
  "historical_documents": [],
  "document_states": [
    "ACTIVE",
    "STALE",
    "SUPERSEDED",
    "DEPRECATED",
    "CANDIDATE"
  ],
  "freshness_states": [
    "NOT_APPLICABLE",
    "ACTIVE",
    "STALE",
    "RESOLVED"
  ],
  "semantic_change_paths": [
    "src/**",
    "scripts/*.py",
    "scripts/*.sh",
    "schemas/**",
    "pyproject.toml",
    ".ai-team/policy/**",
    ".ai-team/runtime/**",
    ".ai-team/contracts/**",
    ".ai-team/verifiers/**",
    ".ai-team/knowledge/**",
    ".agents/skills/**",
    ".claude/skills/**",
    ".ai-team/rules/*.md"
  ],
  "non_semantic_change_paths": [
    "docs/**",
    "README.md",
    "specs/**",
    "testdata/**",
    "**/*.txt",
    "**/.gitignore",
    "docs/assets/**"
  ],
  "impact_rules": [
    {
      "id": "loop-runtime-to-runtime-docs",
      "when_changed": [
        ".ai-team/**",
        ".agents/skills/**",
        ".claude/skills/**",
        "scripts/loopctl.py",
        "scripts/loopv2.py",
        "scripts/eval.sh"
      ],
      "impacted": [
        ".ai-team/README.md",
        ".ai-team/runtime/WORKFLOW.md",
        ".ai-team/verifiers/README.md",
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "reason": "loop runtime contract change"
    }
  ],
  "discovery_axes": [
    {
      "id": "changed_files",
      "source": "git diff + contract scope"
    },
    {
      "id": "impact_rules",
      "source": ".ai-team/policy/documentation.json#impact_rules"
    },
    {
      "id": "knowledge_map",
      "source": ".ai-team/knowledge/map.json"
    },
    {
      "id": "decision_index",
      "source": ".ai-team/knowledge/decisions.index.json"
    },
    {
      "id": "doc_reference",
      "source": "canonical 문서 본문이 changed path를 직접 언급"
    }
  ],
  "keyword_stopwords": [
    "test",
    "tests",
    "build",
    "work",
    "code",
    "main",
    "src",
    "file",
    "data",
    "json",
    "path",
    "tool",
    "tools",
    "spec",
    "docs"
  ],
  "actions": [
    "update",
    "supersede",
    "deprecate",
    "create_candidate",
    "acknowledge",
    "none"
  ],
  "supersede_rule": {
    "never_overwrite": true,
    "required_fields": [
      "status",
      "superseded_by"
    ],
    "reason": "과거 결정은 역사다. 현재 내용에 맞게 덮어쓰지 않는다."
  },
  "reference_scan": {
    "documents": [
      "AGENTS.md",
      "CLAUDE.md",
      ".ai-team/README.md",
      ".ai-team/runtime/WORKFLOW.md",
      ".ai-team/verifiers/README.md"
    ],
    "ignore_patterns": [
      "**/<*",
      "<*"
    ],
    "known_absent": []
  },
  "skip_when": [
    "formatting only",
    "comment only",
    "local typo",
    "generated output refresh"
  ],
  "rule": "canonical 문서는 docs/ 와 각 소유 위치에 둔다. .ai-team 에는 문서 내용을 복사하지 않는다. 큰 문서를 이유 없이 전체 rewrite 하지 않고 impacted section 만 최소 patch 한다.",
  "document_source_routes": [
    {
      "path": ".agents/skills",
      "kind": "source_asset",
      "owner": ".ai-team/runtime/WORKFLOW.md",
      "security": "INTERNAL",
      "reason": "Executable development instructions remain their own source; the current workflow guide documents the controller."
    },
    {
      "path": ".specify/templates",
      "kind": "source_asset",
      "owner": ".ai-team/runtime/WORKFLOW.md",
      "security": "INTERNAL",
      "reason": "Templates are generation inputs, not independently approved current product guides."
    },
    {
      "path": ".specify/memory/constitution.md",
      "kind": "source_asset",
      "owner": ".ai-team/README.md",
      "security": "INTERNAL",
      "reason": "Preserve protected project principles as source inputs; do not rewrite or promote them."
    },
    {
      "path": "docs/workstreams",
      "kind": "historical",
      "security": "INTERNAL",
      "reason": "Existing policy identifies these as historical work records. Require exact baseline retention; no current-guide promotion."
    },
    {
      "path": "docs/roadmaps/history",
      "kind": "historical",
      "security": "INTERNAL",
      "reason": "Existing policy identifies these as milestone history. Preserve the exact baseline and provenance."
    }
  ]
}

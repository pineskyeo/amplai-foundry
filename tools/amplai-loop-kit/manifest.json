{
  "claude_hooks": [
    {
      "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/amplai_hook.py\" session-start",
      "event": "SessionStart",
      "timeout": 5
    },
    {
      "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/amplai_hook.py\" session-end",
      "event": "SessionEnd",
      "timeout": 5
    }
  ],
  "codex_hooks": [
    {
      "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/amplai_hook.py\" session-start --host codex",
      "event": "SessionStart",
      "timeout": 5
    },
    {
      "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/amplai_hook.py\" session-end --host codex",
      "event": "SessionEnd",
      "timeout": 3
    }

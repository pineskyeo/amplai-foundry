{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/goal-contract.schema.json",
  "title": "AMPLAI V3 goal-contract",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "goal_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "scope": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/scope"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "intent_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "resolution_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "mode": {
      "enum": [
        "work",
        "design"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 256
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
            },
            "minItems": 0,
            "maxItems": 256
          },
          "protected": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "statement",
          "source_refs",
          "protected"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "facet": {
            "enum": [
              "functional",
              "compatibility",
              "safety",
              "quality",
              "usability",
              "documentation",
              "performance"
            ]
          },
          "mandatory": {
            "type": "boolean"
          },
          "verifier_ref": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
          },
          "required_evidence_types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 1,
            "maxItems": 256
          },
          "success_rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "human_acceptance_required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "statement",
          "facet",
          "mandatory",
          "verifier_ref",
          "required_evidence_types",
          "success_rule",
          "human_acceptance_required"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/assumption"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "open_question_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "risk": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/risk"
    },
    "budget": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/budget"
    },
    "requested_capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/capability"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "verification_plan_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "context_bundle_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "policy_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "created_at": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/utc"
    }
  },
  "required": [
    "schema_version",
    "goal_id",
    "scope",
    "revision",
    "intent_ref",
    "resolution_ref",
    "mode",
    "objective",
    "non_goals",
    "targets",
    "constraints",
    "acceptance",
    "assumptions",
    "open_question_refs",
    "risk",
    "budget",
    "requested_capabilities",
    "verification_plan_ref",
    "context_bundle_ref",
    "policy_ref",
    "created_at"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/verifier-profile.schema.json",
  "title": "AMPLAI V3 verifier-profile",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "profile_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "kind": {
      "enum": [
        "schema",
        "deterministic",
        "artifact_visual",
        "model_assisted",
        "human"
      ]
    },
    "tool_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "allowed_command_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/capability"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "environment_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "rubric_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "golden_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "protected": {
      "type": "boolean"
    },
    "owner_subject_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "kind",
    "tool_refs",
    "allowed_command_ids",
    "required_capabilities",
    "environment_ref",
    "rubric_ref",
    "golden_refs",
    "protected",
    "owner_subject_id"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/run-record.schema.json",
  "title": "AMPLAI V3 run-record",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "run_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "scope": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/scope"
    },
    "root_goal_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "work_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "contract_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "graph_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "composition_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "context_bundle_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "driver_profile_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "model_profile_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "environment_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "status": {
      "enum": [
        "created",
        "running",
        "pausing",
        "paused",
        "verifying",
        "succeeded",
        "failed",
        "cancelled",
        "lost",
        "unknown_effect"
      ]
    },
    "usage": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/usage"
    },
    "started_at": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/utc"
    },
    "finished_at": {
      "anyOf": [
        {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/utc"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_event_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failure_signatures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 0,
      "maxItems": 256
    },
    "steering_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "effect_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "verdict_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "gate_results": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/gate_result"
      },
      "minItems": 0,
      "maxItems": 256
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "scope",
    "root_goal_id",
    "parent_run_id",
    "work_id",
    "attempt",
    "contract_ref",
    "graph_ref",
    "composition_ref",
    "context_bundle_ref",
    "driver_profile_ref",
    "model_profile_ref",
    "environment_ref",
    "status",
    "usage",
    "started_at",
    "finished_at",
    "last_event_seq",
    "failure_signatures",
    "steering_refs",
    "effect_refs",
    "evidence_refs",
    "verdict_refs",
    "gate_results"
  ],
  "additionalProperties": false
}

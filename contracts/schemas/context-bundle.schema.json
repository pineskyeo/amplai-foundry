{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/context-bundle.schema.json",
  "title": "AMPLAI V3 context-bundle",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "bundle_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "scope": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/scope"
    },
    "contract_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "core_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
          },
          "kind": {
            "enum": [
              "source",
              "concept",
              "principle",
              "decision",
              "question",
              "architecture",
              "experiment",
              "map",
              "repo_fact",
              "work",
              "evidence"
            ]
          },
          "trust": {
            "enum": [
              "control",
              "canonical",
              "observed",
              "untrusted"
            ]
          },
          "mandatory": {
            "type": "boolean"
          },
          "freshness": {
            "enum": [
              "current",
              "stale",
              "unknown"
            ]
          },
          "superseded_by": {
            "anyOf": [
              {
                "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "excerpt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              {
                "type": "null"
              }
            ]
          },
          "source_locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "ref",
          "kind",
          "trust",
          "mandatory",
          "freshness",
          "superseded_by",
          "excerpt",
          "source_locator"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "invariant_registry_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "governing_set_complete": {
      "type": "boolean"
    },
    "token_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "assembled_at": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/utc"
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "scope",
    "contract_ref",
    "core_refs",
    "entries",
    "invariant_registry_ref",
    "governing_set_complete",
    "token_budget",
    "assembled_at"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/resolution.schema.json",
  "title": "AMPLAI V3 resolution",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "resolution_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "scope": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/scope"
    },
    "intent_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "status": {
      "enum": [
        "resolved",
        "hold",
        "rejected"
      ]
    },
    "target_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/assumption"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "readiness": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "area": {
            "enum": [
              "terminology",
              "current_behavior",
              "boundary",
              "invariants",
              "ssot",
              "contradictions",
              "acceptance",
              "verifier"
            ]
          },
          "status": {
            "enum": [
              "ready",
              "missing",
              "conflicting",
              "not_applicable"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
            },
            "minItems": 0,
            "maxItems": 256
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "area",
          "status",
          "source_refs",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 8,
      "maxItems": 8
    },
    "question_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "candidate_contract_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "checked_at": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/utc"
    }
  },
  "required": [
    "schema_version",
    "resolution_id",
    "scope",
    "intent_ref",
    "status",
    "target_refs",
    "facts",
    "readiness",
    "question_refs",
    "candidate_contract_ref",
    "checked_at"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/workgraph.schema.json",
  "title": "AMPLAI V3 workgraph",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "graph_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "scope": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/scope"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "contract_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "previous_graph_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "replan_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
          },
          "work_id": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
          },
          "target_ref": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "strategy": {
            "enum": [
              "direct",
              "bounded_loop",
              "deliberative",
              "discovery"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
            },
            "minItems": 0,
            "maxItems": 64
          },
          "join": {
            "enum": [
              "all_required",
              "any_success_read_only"
            ]
          },
          "consumes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
                },
                "from_node": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "external_ref": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "media_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "output_name": {
                  "anyOf": [
                    {
                      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "name",
                "from_node",
                "external_ref",
                "media_type",
                "output_name"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 256
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
                },
                "media_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "media_type",
                "required"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 256
          },
          "acceptance_ids": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
            },
            "minItems": 1,
            "maxItems": 256
          },
          "verification_profile_ref": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/capability"
            },
            "minItems": 0,
            "maxItems": 256
          },
          "resource_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "resource": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "mode": {
                  "enum": [
                    "shared_read",
                    "exclusive_write"
                  ]
                }
              },
              "required": [
                "resource",
                "mode"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 256
          },
          "budget": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/budget"
          }
        },
        "required": [
          "node_id",
          "work_id",
          "target_ref",
          "objective",
          "strategy",
          "depends_on",
          "join",
          "consumes",
          "produces",
          "acceptance_ids",
          "verification_profile_ref",
          "capabilities",
          "resource_claims",
          "budget"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "global_verification_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "created_at": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/utc"
    }
  },
  "required": [
    "schema_version",
    "graph_id",
    "scope",
    "revision",
    "contract_ref",
    "previous_graph_ref",
    "replan_reason",
    "nodes",
    "global_verification_ref",
    "compiler_version",
    "created_at"
  ],
  "additionalProperties": false
}

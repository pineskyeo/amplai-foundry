{
  "$defs": {
    "MinimalEvaluationRecord": {
      "additionalProperties": false,
      "description": "Phase 1 seed record for the later Evaluation Observatory.",
      "properties": {
        "classification": {
          "enum": [
            "pass",
            "hold",
            "fail"
          ],
          "title": "Classification",
          "type": "string"
        },
        "duplicate_created": {
          "title": "Duplicate Created",
          "type": "boolean"
        },
        "failure_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Category"
        },
        "fixture_id": {
          "minLength": 1,
          "title": "Fixture Id",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "project_resolution": {
          "enum": [
            "pass",
            "hold",
            "fail"
          ],
          "title": "Project Resolution",
          "type": "string"
        },
        "proposal_reproducible": {
          "title": "Proposal Reproducible",
          "type": "boolean"
        },
        "safe_change_applied": {
          "default": false,
          "title": "Safe Change Applied",
          "type": "boolean"
        },
        "token_usage": {
          "minimum": 0,
          "title": "Token Usage",
          "type": "integer"
        },
        "unsafe_change_applied": {
          "title": "Unsafe Change Applied",
          "type": "boolean"
        },
        "user_corrections": {
          "minimum": 0,
          "title": "User Corrections",
          "type": "integer"
        }
      },
      "required": [
        "fixture_id",
        "project_resolution",
        "classification",
        "duplicate_created",
        "unsafe_change_applied",
        "proposal_reproducible",
        "user_corrections",
        "latency_ms",
        "token_usage"
      ],
      "title": "MinimalEvaluationRecord",
      "type": "object"
    },
    "ProjectRef": {
      "additionalProperties": false,
      "description": "Stable identity for one project independent of its clone path.",
      "properties": {
        "namespace": {
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$",
          "title": "Namespace",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "namespace"
      ],
      "title": "ProjectRef",
      "type": "object"
    },
    "ValidationCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "passed",
        "detail"
      ],
      "title": "ValidationCheck",
      "type": "object"
    },
    "ValidationReport": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/ValidationCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "evaluation": {
          "$ref": "#/$defs/MinimalEvaluationRecord"
        }
      },
      "required": [
        "checks",
        "evaluation"
      ],
      "title": "ValidationReport",
      "type": "object"
    }
  },
  "$id": "https://amplai.local/schemas/resolution-hold.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Workspace-level replay seed written before any Project Pack is selected.",
  "properties": {
    "artifact_count": {
      "minimum": 1,
      "title": "Artifact Count",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "hold_id": {
      "pattern": "^HOLD-[A-F0-9]{16}$",
      "title": "Hold Id",
      "type": "string"
    },
    "project": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "project_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Hint"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "validation": {
      "$ref": "#/$defs/ValidationReport"
    }
  },
  "required": [
    "hold_id",
    "created_at",
    "request_fingerprint",
    "artifact_count",
    "reason",
    "validation"
  ],
  "title": "AMPLAI Resolution Hold",
  "type": "object"
}

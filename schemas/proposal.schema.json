{
  "$defs": {
    "Confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "EvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        },
        "type": {
          "const": "line_range",
          "default": "line_range",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "EvidenceLocator",
      "type": "object"
    },
    "OperationType": {
      "enum": [
        "CREATE",
        "UPDATE",
        "LINK",
        "MERGE",
        "SPLIT",
        "SUPERSEDE",
        "CONFLICT",
        "IGNORE"
      ],
      "title": "OperationType",
      "type": "string"
    },
    "ProposalEvidence": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "$ref": "#/$defs/EvidenceLocator"
        },
        "source_id": {
          "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9-]+$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "locator"
      ],
      "title": "ProposalEvidence",
      "type": "object"
    },
    "ProposalOperation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "draft_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Draft Path"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ProposalEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        },
        "expected_target_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Target Sha256"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^OP-[0-9]{3}$",
          "title": "Operation Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/OperationType"
        }
      },
      "required": [
        "operation_id",
        "type",
        "kind",
        "title",
        "reason",
        "evidence",
        "confidence"
      ],
      "title": "ProposalOperation",
      "type": "object"
    },
    "ProposalStatus": {
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "applied",
        "rejected",
        "superseded"
      ],
      "title": "ProposalStatus",
      "type": "string"
    }
  },
  "$id": "https://amplai.local/schemas/proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reviewed change set derived from immutable source evidence.",
  "properties": {
    "applied_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applied At"
    },
    "applied_by": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applied By"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "approved_by": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved By"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "minLength": 1,
      "title": "Created By",
      "type": "string"
    },
    "git_commit_sha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{7,40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Commit Sha"
    },
    "namespace": {
      "minLength": 1,
      "title": "Namespace",
      "type": "string"
    },
    "notes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/ProposalOperation"
      },
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "project": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Project",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^PROP-[0-9]{8}-[A-F0-9]{8}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "proposal_version": {
      "const": 1,
      "default": 1,
      "title": "Proposal Version",
      "type": "integer"
    },
    "source_ids": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9-]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ProposalStatus",
      "default": "draft"
    }
  },
  "required": [
    "proposal_id",
    "project",
    "namespace",
    "source_ids",
    "created_at",
    "created_by",
    "operations"
  ],
  "title": "AMPLAI Knowledge Proposal",
  "type": "object"
}

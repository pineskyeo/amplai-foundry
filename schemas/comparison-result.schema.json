{
  "$defs": {
    "ComparisonRelation": {
      "enum": [
        "EXACT_DUPLICATE",
        "SEMANTIC_DUPLICATE",
        "REFINES",
        "CONFLICTS",
        "NEW",
        "UNCERTAIN"
      ],
      "title": "ComparisonRelation",
      "type": "string"
    },
    "ComparisonSignals": {
      "additionalProperties": false,
      "properties": {
        "alias_match": {
          "default": false,
          "title": "Alias Match",
          "type": "boolean"
        },
        "constraint_relation": {
          "default": "none",
          "title": "Constraint Relation",
          "type": "string"
        },
        "lexical_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Lexical Score",
          "type": "number"
        },
        "signature_match": {
          "default": false,
          "title": "Signature Match",
          "type": "boolean"
        },
        "subject_match": {
          "default": false,
          "title": "Subject Match",
          "type": "boolean"
        }
      },
      "required": [
        "lexical_score"
      ],
      "title": "ComparisonSignals",
      "type": "object"
    },
    "MemoryRef": {
      "additionalProperties": false,
      "description": "Qualified memory identity; local IDs are only unique inside a namespace.",
      "properties": {
        "local_id": {
          "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9-]+$",
          "title": "Local Id",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "local_id"
      ],
      "title": "MemoryRef",
      "type": "object"
    }
  },
  "$id": "https://amplai.local/schemas/comparison-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "pattern": "^CAND-[A-F0-9]{12}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "matched_semantic_id": {
      "anyOf": [
        {
          "pattern": "^SEM-[A-F0-9]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Matched Semantic Id"
    },
    "matched_target_refs": {
      "items": {
        "$ref": "#/$defs/MemoryRef"
      },
      "title": "Matched Target Refs",
      "type": "array"
    },
    "reason_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "recommended_operation": {
      "title": "Recommended Operation",
      "type": "string"
    },
    "relation": {
      "$ref": "#/$defs/ComparisonRelation"
    },
    "requires_review": {
      "title": "Requires Review",
      "type": "boolean"
    },
    "signals": {
      "$ref": "#/$defs/ComparisonSignals"
    }
  },
  "required": [
    "candidate_id",
    "relation",
    "confidence",
    "signals",
    "reason_codes",
    "recommended_operation",
    "requires_review"
  ],
  "title": "AMPLAI Semantic Comparison Result",
  "type": "object"
}

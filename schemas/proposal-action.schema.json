{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^ACT-[A-Z0-9-]+$",
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        }
      },
      "required": [
        "actor_id",
        "actor_type"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "human",
        "service",
        "agent"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "ChannelProvider": {
      "enum": [
        "slack",
        "telegram",
        "hermes",
        "web",
        "cli"
      ],
      "title": "ChannelProvider",
      "type": "string"
    },
    "ChannelRef": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Id"
        },
        "chat_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chat Id"
        },
        "message_id": {
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ChannelProvider"
        },
        "thread_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "workspace_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Id"
        }
      },
      "required": [
        "provider",
        "message_id"
      ],
      "title": "ChannelRef",
      "type": "object"
    },
    "ProjectRef": {
      "additionalProperties": false,
      "description": "Stable identity for one project independent of its clone path.",
      "properties": {
        "namespace": {
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$",
          "title": "Namespace",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "namespace"
      ],
      "title": "ProjectRef",
      "type": "object"
    },
    "ProposalActionType": {
      "enum": [
        "approve",
        "reject",
        "request_changes",
        "apply"
      ],
      "title": "ProposalActionType",
      "type": "string"
    },
    "ProposalRef": {
      "additionalProperties": false,
      "properties": {
        "project_ref": {
          "$ref": "#/$defs/ProjectRef"
        },
        "proposal_id": {
          "pattern": "^PROP-[0-9]{8}-[A-F0-9]{8}$",
          "title": "Proposal Id",
          "type": "string"
        }
      },
      "required": [
        "project_ref",
        "proposal_id"
      ],
      "title": "ProposalRef",
      "type": "object"
    }
  },
  "$id": "https://amplai.local/schemas/proposal-action.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/ProposalActionType"
    },
    "action_token": {
      "maxLength": 256,
      "minLength": 8,
      "title": "Action Token",
      "type": "string"
    },
    "actor_ref": {
      "$ref": "#/$defs/ActorRef"
    },
    "channel_ref": {
      "$ref": "#/$defs/ChannelRef"
    },
    "expected_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Expected Digest",
      "type": "string"
    },
    "expected_version": {
      "minimum": 1,
      "title": "Expected Version",
      "type": "integer"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "proposal_ref": {
      "$ref": "#/$defs/ProposalRef"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "proposal_ref",
    "expected_version",
    "expected_digest",
    "action",
    "actor_ref",
    "channel_ref",
    "action_token",
    "idempotency_key",
    "occurred_at"
  ],
  "title": "AMPLAI Proposal Action",
  "type": "object"
}

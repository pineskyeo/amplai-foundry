{
  "$defs": {
    "RoadmapPhase": {
      "additionalProperties": false,
      "properties": {
        "definition_of_done": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Definition Of Done",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]+$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]+$",
          "title": "Id",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/RoadmapPhaseStatus"
        }
      },
      "required": [
        "id",
        "order",
        "status"
      ],
      "title": "RoadmapPhase",
      "type": "object"
    },
    "RoadmapPhaseStatus": {
      "enum": [
        "backlog",
        "planned",
        "in_progress",
        "blocked",
        "completed",
        "cancelled",
        "superseded"
      ],
      "title": "RoadmapPhaseStatus",
      "type": "string"
    },
    "RoadmapStatus": {
      "enum": [
        "draft",
        "approved",
        "archived",
        "superseded"
      ],
      "title": "RoadmapStatus",
      "type": "string"
    }
  },
  "$id": "https://amplai.local/schemas/roadmap.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applied_proposal_id": {
      "anyOf": [
        {
          "pattern": "^RMAP-[0-9]{8}-[A-F0-9]{8}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applied Proposal Id"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "approved_by": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved By"
    },
    "current_focus": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Focus"
    },
    "north_star": {
      "additionalProperties": true,
      "title": "North Star",
      "type": "object"
    },
    "phases": {
      "items": {
        "$ref": "#/$defs/RoadmapPhase"
      },
      "title": "Phases",
      "type": "array"
    },
    "roadmap_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Roadmap Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/RoadmapStatus"
    },
    "updated_at": {
      "format": "date",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "roadmap_id",
    "version",
    "status",
    "updated_at",
    "phases"
  ],
  "title": "AMPLAI Roadmap Definition",
  "type": "object"
}

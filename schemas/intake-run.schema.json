{
  "$defs": {
    "ArtifactClassification": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "held": {
          "default": false,
          "title": "Held",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "confidence",
        "reason_codes"
      ],
      "title": "ArtifactClassification",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "roadmap",
        "architecture_proposal",
        "meeting_note",
        "incident",
        "sop",
        "implementation_result",
        "unknown"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "default": "text/markdown",
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "source_type": {
          "default": "document",
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CandidateEvidence": {
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/MemoryRef"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "start_line",
        "end_line"
      ],
      "title": "CandidateEvidence",
      "type": "object"
    },
    "ChannelProvider": {
      "enum": [
        "slack",
        "telegram",
        "hermes",
        "web",
        "cli"
      ],
      "title": "ChannelProvider",
      "type": "string"
    },
    "ChannelRef": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Id"
        },
        "chat_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chat Id"
        },
        "message_id": {
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ChannelProvider"
        },
        "thread_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "workspace_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Id"
        }
      },
      "required": [
        "provider",
        "message_id"
      ],
      "title": "ChannelRef",
      "type": "object"
    },
    "ClaimModality": {
      "enum": [
        "must",
        "must_not",
        "should",
        "should_not",
        "may",
        "is",
        "is_not"
      ],
      "title": "ClaimModality",
      "type": "string"
    },
    "ComparisonRelation": {
      "enum": [
        "EXACT_DUPLICATE",
        "SEMANTIC_DUPLICATE",
        "REFINES",
        "CONFLICTS",
        "NEW",
        "UNCERTAIN"
      ],
      "title": "ComparisonRelation",
      "type": "string"
    },
    "ComparisonResult": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^CAND-[A-F0-9]{12}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "matched_semantic_id": {
          "anyOf": [
            {
              "pattern": "^SEM-[A-F0-9]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Semantic Id"
        },
        "matched_target_refs": {
          "items": {
            "$ref": "#/$defs/MemoryRef"
          },
          "title": "Matched Target Refs",
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "recommended_operation": {
          "title": "Recommended Operation",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/ComparisonRelation"
        },
        "requires_review": {
          "title": "Requires Review",
          "type": "boolean"
        },
        "signals": {
          "$ref": "#/$defs/ComparisonSignals"
        }
      },
      "required": [
        "candidate_id",
        "relation",
        "confidence",
        "signals",
        "reason_codes",
        "recommended_operation",
        "requires_review"
      ],
      "title": "ComparisonResult",
      "type": "object"
    },
    "ComparisonSignals": {
      "additionalProperties": false,
      "properties": {
        "alias_match": {
          "default": false,
          "title": "Alias Match",
          "type": "boolean"
        },
        "constraint_relation": {
          "default": "none",
          "title": "Constraint Relation",
          "type": "string"
        },
        "lexical_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Lexical Score",
          "type": "number"
        },
        "signature_match": {
          "default": false,
          "title": "Signature Match",
          "type": "boolean"
        },
        "subject_match": {
          "default": false,
          "title": "Subject Match",
          "type": "boolean"
        }
      },
      "required": [
        "lexical_score"
      ],
      "title": "ComparisonSignals",
      "type": "object"
    },
    "ExternalActorIdentity": {
      "additionalProperties": false,
      "description": "Untrusted identity facts accepted by public ingress and Intake requests.",
      "properties": {
        "channel": {
          "$ref": "#/$defs/ChannelRef"
        },
        "external_actor_id": {
          "minLength": 1,
          "title": "External Actor Id",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ChannelProvider"
        },
        "provider_installation_ref": {
          "minLength": 1,
          "title": "Provider Installation Ref",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "provider_installation_ref",
        "external_actor_id",
        "request_id",
        "channel"
      ],
      "title": "ExternalActorIdentity",
      "type": "object"
    },
    "IntentRequest": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Artifacts",
          "type": "array"
        },
        "expected_outcome": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Outcome"
        },
        "identity": {
          "$ref": "#/$defs/ExternalActorIdentity"
        },
        "instruction": {
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "project_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Hint"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "instruction",
        "artifacts",
        "identity"
      ],
      "title": "IntentRequest",
      "type": "object"
    },
    "KnowledgeCandidate": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "candidate_id": {
          "pattern": "^CAND-[A-F0-9]{12}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "canonical_statement": {
          "minLength": 1,
          "title": "Canonical Statement",
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/SemanticClaim"
        },
        "constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CandidateEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "project": {
          "$ref": "#/$defs/ProjectRef"
        },
        "scope": {
          "$ref": "#/$defs/SemanticScope"
        },
        "signature": {
          "title": "Signature",
          "type": "string"
        },
        "suggested_kinds": {
          "items": {
            "$ref": "#/$defs/MemoryKind"
          },
          "minItems": 1,
          "title": "Suggested Kinds",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "project",
        "scope",
        "claim",
        "canonical_statement",
        "suggested_kinds",
        "evidence",
        "signature"
      ],
      "title": "KnowledgeCandidate",
      "type": "object"
    },
    "MemoryKind": {
      "description": "Kinds of reviewed, long-lived project knowledge.",
      "enum": [
        "source",
        "concept",
        "principle",
        "decision",
        "question",
        "architecture",
        "experiment",
        "map"
      ],
      "title": "MemoryKind",
      "type": "string"
    },
    "MemoryRef": {
      "additionalProperties": false,
      "description": "Qualified memory identity; local IDs are only unique inside a namespace.",
      "properties": {
        "local_id": {
          "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9-]+$",
          "title": "Local Id",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "local_id"
      ],
      "title": "MemoryRef",
      "type": "object"
    },
    "MinimalEvaluationRecord": {
      "additionalProperties": false,
      "description": "Phase 1 seed record for the later Evaluation Observatory.",
      "properties": {
        "classification": {
          "enum": [
            "pass",
            "hold",
            "fail"
          ],
          "title": "Classification",
          "type": "string"
        },
        "duplicate_created": {
          "title": "Duplicate Created",
          "type": "boolean"
        },
        "failure_category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Category"
        },
        "fixture_id": {
          "minLength": 1,
          "title": "Fixture Id",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "project_resolution": {
          "enum": [
            "pass",
            "hold",
            "fail"
          ],
          "title": "Project Resolution",
          "type": "string"
        },
        "proposal_reproducible": {
          "title": "Proposal Reproducible",
          "type": "boolean"
        },
        "safe_change_applied": {
          "default": false,
          "title": "Safe Change Applied",
          "type": "boolean"
        },
        "token_usage": {
          "minimum": 0,
          "title": "Token Usage",
          "type": "integer"
        },
        "unsafe_change_applied": {
          "title": "Unsafe Change Applied",
          "type": "boolean"
        },
        "user_corrections": {
          "minimum": 0,
          "title": "User Corrections",
          "type": "integer"
        }
      },
      "required": [
        "fixture_id",
        "project_resolution",
        "classification",
        "duplicate_created",
        "unsafe_change_applied",
        "proposal_reproducible",
        "user_corrections",
        "latency_ms",
        "token_usage"
      ],
      "title": "MinimalEvaluationRecord",
      "type": "object"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/PolicyDisposition"
        },
        "reason_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel"
        }
      },
      "required": [
        "candidate_id",
        "risk",
        "disposition",
        "reason_codes"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "PolicyDisposition": {
      "enum": [
        "auto_apply",
        "review_required",
        "hold",
        "ignore"
      ],
      "title": "PolicyDisposition",
      "type": "string"
    },
    "ProjectRef": {
      "additionalProperties": false,
      "description": "Stable identity for one project independent of its clone path.",
      "properties": {
        "namespace": {
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$",
          "title": "Namespace",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "namespace"
      ],
      "title": "ProjectRef",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "restricted"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "SemanticClaim": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "modality": {
          "$ref": "#/$defs/ClaimModality"
        },
        "object": {
          "minLength": 1,
          "title": "Object",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        }
      },
      "required": [
        "modality",
        "action",
        "object"
      ],
      "title": "SemanticClaim",
      "type": "object"
    },
    "SemanticScope": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "target",
        "actor"
      ],
      "title": "SemanticScope",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/MemoryRef"
        },
        "status": {
          "enum": [
            "created",
            "duplicate"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "ref",
        "path",
        "content_sha256"
      ],
      "title": "SourceRecord",
      "type": "object"
    },
    "ValidationCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "passed",
        "detail"
      ],
      "title": "ValidationCheck",
      "type": "object"
    },
    "ValidationReport": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/ValidationCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "evaluation": {
          "$ref": "#/$defs/MinimalEvaluationRecord"
        }
      },
      "required": [
        "checks",
        "evaluation"
      ],
      "title": "ValidationReport",
      "type": "object"
    }
  },
  "$id": "https://amplai.local/schemas/intake-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/KnowledgeCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "classification": {
      "$ref": "#/$defs/ArtifactClassification"
    },
    "comparisons": {
      "items": {
        "$ref": "#/$defs/ComparisonResult"
      },
      "title": "Comparisons",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "policy_decisions": {
      "items": {
        "$ref": "#/$defs/PolicyDecision"
      },
      "title": "Policy Decisions",
      "type": "array"
    },
    "project": {
      "$ref": "#/$defs/ProjectRef"
    },
    "proposal_id": {
      "anyOf": [
        {
          "pattern": "^PROP-[0-9]{8}-[A-F0-9]{8}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposal Id"
    },
    "request": {
      "$ref": "#/$defs/IntentRequest"
    },
    "roadmap_update_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Roadmap Update Path"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/SourceRecord"
    },
    "validation": {
      "$ref": "#/$defs/ValidationReport"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "project",
    "request",
    "source",
    "classification",
    "validation"
  ],
  "title": "AMPLAI Intake Run",
  "type": "object"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amplai.local/schemas/note.schema.json",
  "title": "AMPLAI Memory Object Front Matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "namespace",
    "project",
    "kind",
    "status",
    "title",
    "summary",
    "created_at",
    "updated_at",
    "source_refs",
    "relations",
    "revision",
    "tags"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9-]+$"},
    "namespace": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "kind": {
      "enum": ["source", "concept", "principle", "decision", "question", "architecture", "experiment", "map"]
    },
    "status": {
      "enum": ["candidate", "active", "superseded", "deprecated", "merged", "rejected", "archived"]
    },
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date"},
    "updated_at": {"type": "string", "format": "date"},
    "source_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9-]+$"}
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": {
            "enum": ["related_to", "depends_on", "supports", "contradicts", "supersedes", "implements", "derived_from"]
          },
          "target": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9-]+$"}
        }
      }
    },
    "superseded_by": {"type": ["string", "null"]},
    "merged_into": {"type": ["string", "null"]},
    "revision": {"type": "integer", "minimum": 1},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}

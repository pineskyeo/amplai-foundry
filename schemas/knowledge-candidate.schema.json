{
  "$defs": {
    "CandidateEvidence": {
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/MemoryRef"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "start_line",
        "end_line"
      ],
      "title": "CandidateEvidence",
      "type": "object"
    },
    "ClaimModality": {
      "enum": [
        "must",
        "must_not",
        "should",
        "should_not",
        "may",
        "is",
        "is_not"
      ],
      "title": "ClaimModality",
      "type": "string"
    },
    "MemoryKind": {
      "description": "Kinds of reviewed, long-lived project knowledge.",
      "enum": [
        "source",
        "concept",
        "principle",
        "decision",
        "question",
        "architecture",
        "experiment",
        "map"
      ],
      "title": "MemoryKind",
      "type": "string"
    },
    "MemoryRef": {
      "additionalProperties": false,
      "description": "Qualified memory identity; local IDs are only unique inside a namespace.",
      "properties": {
        "local_id": {
          "pattern": "^[A-Z][A-Z0-9]*-[A-Z0-9-]+$",
          "title": "Local Id",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "local_id"
      ],
      "title": "MemoryRef",
      "type": "object"
    },
    "ProjectRef": {
      "additionalProperties": false,
      "description": "Stable identity for one project independent of its clone path.",
      "properties": {
        "namespace": {
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$",
          "title": "Namespace",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "namespace"
      ],
      "title": "ProjectRef",
      "type": "object"
    },
    "SemanticClaim": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "modality": {
          "$ref": "#/$defs/ClaimModality"
        },
        "object": {
          "minLength": 1,
          "title": "Object",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        }
      },
      "required": [
        "modality",
        "action",
        "object"
      ],
      "title": "SemanticClaim",
      "type": "object"
    },
    "SemanticScope": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "domain": {
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "target",
        "actor"
      ],
      "title": "SemanticScope",
      "type": "object"
    }
  },
  "$id": "https://amplai.local/schemas/knowledge-candidate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aliases": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "candidate_id": {
      "pattern": "^CAND-[A-F0-9]{12}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "canonical_statement": {
      "minLength": 1,
      "title": "Canonical Statement",
      "type": "string"
    },
    "claim": {
      "$ref": "#/$defs/SemanticClaim"
    },
    "constraints": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/CandidateEvidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "project": {
      "$ref": "#/$defs/ProjectRef"
    },
    "scope": {
      "$ref": "#/$defs/SemanticScope"
    },
    "signature": {
      "title": "Signature",
      "type": "string"
    },
    "suggested_kinds": {
      "items": {
        "$ref": "#/$defs/MemoryKind"
      },
      "minItems": 1,
      "title": "Suggested Kinds",
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "project",
    "scope",
    "claim",
    "canonical_statement",
    "suggested_kinds",
    "evidence",
    "signature"
  ],
  "title": "AMPLAI Knowledge Candidate",
  "type": "object"
}

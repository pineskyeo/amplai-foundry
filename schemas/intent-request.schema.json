{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "default": "text/markdown",
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "source_type": {
          "default": "document",
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ChannelProvider": {
      "enum": [
        "slack",
        "telegram",
        "hermes",
        "web",
        "cli"
      ],
      "title": "ChannelProvider",
      "type": "string"
    },
    "ChannelRef": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Id"
        },
        "chat_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chat Id"
        },
        "message_id": {
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ChannelProvider"
        },
        "thread_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "workspace_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Id"
        }
      },
      "required": [
        "provider",
        "message_id"
      ],
      "title": "ChannelRef",
      "type": "object"
    },
    "ExternalActorIdentity": {
      "additionalProperties": false,
      "description": "Untrusted identity facts accepted by public ingress and Intake requests.",
      "properties": {
        "channel": {
          "$ref": "#/$defs/ChannelRef"
        },
        "external_actor_id": {
          "minLength": 1,
          "title": "External Actor Id",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ChannelProvider"
        },
        "provider_installation_ref": {
          "minLength": 1,
          "title": "Provider Installation Ref",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "provider_installation_ref",
        "external_actor_id",
        "request_id",
        "channel"
      ],
      "title": "ExternalActorIdentity",
      "type": "object"
    }
  },
  "$id": "https://amplai.local/schemas/intent-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "expected_outcome": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Outcome"
    },
    "identity": {
      "$ref": "#/$defs/ExternalActorIdentity"
    },
    "instruction": {
      "minLength": 1,
      "title": "Instruction",
      "type": "string"
    },
    "project_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Hint"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "instruction",
    "artifacts",
    "identity"
  ],
  "title": "AMPLAI Intent Request",
  "type": "object"
}

{
  "$defs": {
    "RoadmapChange": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "item_id": {
          "pattern": "^[a-z0-9][a-z0-9-]+$",
          "title": "Item Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/RoadmapChangeType"
        }
      },
      "required": [
        "item_id",
        "type",
        "reason"
      ],
      "title": "RoadmapChange",
      "type": "object"
    },
    "RoadmapChangeType": {
      "enum": [
        "ADD",
        "UPDATE",
        "MOVE",
        "CANCEL",
        "SUPERSEDE"
      ],
      "title": "RoadmapChangeType",
      "type": "string"
    },
    "RoadmapImpactAnalysis": {
      "additionalProperties": false,
      "properties": {
        "changed_items": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]+$",
            "type": "string"
          },
          "title": "Changed Items",
          "type": "array"
        },
        "current_focus_affected": {
          "title": "Current Focus Affected",
          "type": "boolean"
        },
        "directly_dependent_items": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]+$",
            "type": "string"
          },
          "title": "Directly Dependent Items",
          "type": "array"
        },
        "requires_replan": {
          "title": "Requires Replan",
          "type": "boolean"
        },
        "transitive_dependent_items": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]+$",
            "type": "string"
          },
          "title": "Transitive Dependent Items",
          "type": "array"
        }
      },
      "required": [
        "changed_items",
        "directly_dependent_items",
        "transitive_dependent_items",
        "current_focus_affected",
        "requires_replan"
      ],
      "title": "RoadmapImpactAnalysis",
      "type": "object"
    },
    "RoadmapProposalStatus": {
      "enum": [
        "draft",
        "approved",
        "applied",
        "rejected"
      ],
      "title": "RoadmapProposalStatus",
      "type": "string"
    }
  },
  "$id": "https://amplai.local/schemas/roadmap-proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "approved_by": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved By"
    },
    "base_version": {
      "minimum": 1,
      "title": "Base Version",
      "type": "integer"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/RoadmapChange"
      },
      "minItems": 1,
      "title": "Changes",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "minLength": 1,
      "title": "Created By",
      "type": "string"
    },
    "impact": {
      "$ref": "#/$defs/RoadmapImpactAnalysis"
    },
    "proposal_id": {
      "pattern": "^RMAP-[0-9]{8}-[A-F0-9]{8}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "proposed_version": {
      "minimum": 2,
      "title": "Proposed Version",
      "type": "integer"
    },
    "roadmap_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Roadmap Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/RoadmapProposalStatus",
      "default": "draft"
    }
  },
  "required": [
    "proposal_id",
    "roadmap_id",
    "base_version",
    "proposed_version",
    "created_at",
    "created_by",
    "changes",
    "impact"
  ],
  "title": "AMPLAI Roadmap Change Proposal",
  "type": "object"
}

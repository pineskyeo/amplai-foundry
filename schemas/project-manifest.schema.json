{
  "$defs": {
    "CanonicalPaths": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "default": ".amplai/agents",
          "title": "Agents",
          "type": "string"
        },
        "evals": {
          "default": ".amplai/evals",
          "title": "Evals",
          "type": "string"
        },
        "intake": {
          "default": ".amplai/intake",
          "title": "Intake",
          "type": "string"
        },
        "memory": {
          "title": "Memory",
          "type": "string"
        },
        "ontology": {
          "default": ".amplai/ontology",
          "title": "Ontology",
          "type": "string"
        },
        "policies": {
          "default": ".amplai/policies",
          "title": "Policies",
          "type": "string"
        },
        "proposals": {
          "default": ".amplai/proposals",
          "title": "Proposals",
          "type": "string"
        },
        "roadmap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roadmap"
        },
        "semantic": {
          "default": ".amplai/semantic",
          "title": "Semantic",
          "type": "string"
        },
        "skills": {
          "default": ".amplai/skills",
          "title": "Skills",
          "type": "string"
        }
      },
      "required": [
        "memory"
      ],
      "title": "CanonicalPaths",
      "type": "object"
    },
    "DomainImport": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Module",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+(?:\\.[0-9]+)*(?:\\.x)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "module",
        "version"
      ],
      "title": "DomainImport",
      "type": "object"
    },
    "RuntimePaths": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "default": ".amplai/runtime",
          "title": "Root",
          "type": "string"
        }
      },
      "title": "RuntimePaths",
      "type": "object"
    }
  },
  "$id": "https://amplai.local/schemas/project-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Clone-path-independent Project Pack manifest.",
  "properties": {
    "aliases": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "canonical": {
      "$ref": "#/$defs/CanonicalPaths"
    },
    "default": {
      "default": false,
      "title": "Default",
      "type": "boolean"
    },
    "imports": {
      "items": {
        "$ref": "#/$defs/DomainImport"
      },
      "title": "Imports",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "namespace": {
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$",
      "title": "Namespace",
      "type": "string"
    },
    "profiles": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Profiles",
      "type": "array"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimePaths"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "project_id",
    "namespace",
    "name",
    "canonical"
  ],
  "title": "AMPLAI Project Pack Manifest",
  "type": "object"
}

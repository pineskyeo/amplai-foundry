    {
      "name": "pending_events",
      "description": "Notifications for the linked operator's goals after a cursor (fixed schema: goal, event type, status, time). Without a cursor: a snapshot and the cursor to follow from.",
      "input_schema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
            "description": "The messenger name in lowercase, as the identity map writes it."
          },
          "workspace_id": {
            "type": "string",
            "pattern": "^[^\\s]{1,256}$",
            "description": "The messenger workspace (team) id of the sender."
          },
          "user_id": {
            "type": "string",
            "pattern": "^[^\\s]{1,256}$",
            "description": "The messenger user id of the sender."
          },
          "cursor": {
            "type": "string",
            "pattern": "^[^\\s]{1,200}:[0-9]{1,18}$",
            "description": "Opaque feed cursor from the previous pending_events result."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "provider",
          "workspace_id",
          "user_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seq": {
                  "type": "integer",
                  "minimum": 1
                },
                "goal_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "description": "An AMPLAI goal id."
                },
                "event": {
                  "type": "string",
                  "pattern": "^([a-z][a-z0-9_]*(\\.[a-z0-9_]+)*|other)$"
                },
                "status": {
                  "type": "string",
                  "pattern": "^[a-z][a-z_]{0,31}$",
                  "description": "The goal's status from AMPLAI's closed set, or unknown."
                },
                "at": {
                  "type": "string"
                }
              },
              "required": [
                "seq",
                "goal_id",
                "event",
                "status",
                "at"
              ],
              "additionalProperties": false
            }
          },
          "cursor": {
            "type": "string",
            "pattern": "^[^\\s]{1,200}:[0-9]{1,18}$",
            "description": "Opaque feed cursor from the previous pending_events result."
          },
          "snapshot": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "goal_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
                  "description": "An AMPLAI goal id."
                },
                "status": {
                  "type": "string",
                  "pattern": "^[a-z][a-z_]{0,31}$",
                  "description": "The goal's status from AMPLAI's closed set, or unknown."
                },
                "at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Time of the goal's latest event (RFC 3339 UTC)."
                }
              },
              "required": [
                "goal_id",
                "status",
                "at"
              ],
              "additionalProperties": false
            }
          },
          "expired": {
            "type": "boolean",
            "description": "True when the cursor was from another store generation: start again from snapshot and cursor."
          }
        },
        "required": [
          "items",
          "cursor"
        ],
        "additionalProperties": false
      },
      "route": {
        "method": "GET",
        "path": "/events"
      }
    }

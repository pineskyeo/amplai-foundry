{
  "contract": "amplai-intake-tools",
  "version": "1",
  "description": "AMPLAI intake tools for a messenger front agent (Work 034 S1c, spec F-4). Front-agent neutral: each tool maps to one /api/v3/intake/{adapter_id} route.",
  "tools": [
    {
      "name": "submit_work",
      "description": "Submit the operator's message as an AMPLAI work goal. AMPLAI drafts a contract; only the operator approves it, never the front agent.",
      "input_schema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
            "description": "The messenger name in lowercase, as the identity map writes it."
          },
          "workspace_id": {
            "type": "string",
            "pattern": "^[^\\s]{1,256}$",
            "description": "The messenger workspace (team) id of the sender."
          },
          "user_id": {
            "type": "string",
            "pattern": "^[^\\s]{1,256}$",
            "description": "The messenger user id of the sender."
          },
          "channel_id": {
            "type": "string",
            "pattern": "^[^\\s]{1,256}$",
            "description": "The messenger channel id the message came from."
          },
          "message_id": {
            "type": "string",
            "pattern": "^[^\\s]{1,256}$",
            "description": "The messenger message id: a resend of the same message is accepted once."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        },
        "required": [
          "provider",
          "workspace_id",
          "user_id",
          "channel_id",
          "message_id",
          "text"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "goal_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
            "description": "An AMPLAI goal id."
          },
          "status": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{0,31}$",
            "description": "The goal's status from AMPLAI's closed set, or unknown."
          },
          "at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Time of the goal's latest event (RFC 3339 UTC)."
          }
        },
        "required": [
          "goal_id",
          "status",
          "at"
        ],
        "additionalProperties": false
      },
      "route": {
        "method": "POST",
        "path": "",
        "mode": "work"
      }
    },

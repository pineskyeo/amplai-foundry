# $HERMES_HOME/.env on the Hermes VM (chmod 600). Fill <...>. Never commit the filled file.
#
# Slack app 1 of 2: the Hermes bot (Socket Mode). App 2, the AMPLAI alert webhook, is NOT here:
# its URL lives only on the AMPLAI host (README.ko.md, "Slack 앱 두 개").
SLACK_BOT_TOKEN=<xoxb-...>
SLACK_APP_TOKEN=<xapp-... with connections:write>
SLACK_ALLOWED_USERS=<the operator's Slack member id, U...>
SLACK_HOME_CHANNEL=<C... channel for cron output>

# The intake adapter token of AMPLAI adapter `hermes` (32+ characters). The same value as the
# AMPLAI host's intake token file; config.yaml passes it to the AMPLAI MCP server only.
AMPLAI_INTAKE_TOKEN=<token>

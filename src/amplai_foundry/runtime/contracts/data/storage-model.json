        },
        {
          "name": "key",
          "logical_type": "string"
        },
        {
          "name": "payload_digest",
          "logical_type": "digest"
        },
        {
          "name": "response_digest",
          "logical_type": "digest"
        },
        {
          "name": "created_at",

{
  "version": "3.0.0",
  "kind": "logical_schema_design_not_executable_migration",
  "default_backend": "SQLite local disk single active CP",
  "all_tables_include": [
    "tenant_id TEXT NOT NULL",
    "project_id TEXT NOT NULL"
  ],
  "tables": [
    {
      "name": "intents",
      "owner": "RuntimeService",
      "primary_key": "tenant_id,project_id,intent_id",
      "columns": [
        {
          "name": "intent_id",
          "logical_type": "id"
        },
        {
          "name": "actor_id",
          "logical_type": "id"
        },
        {
          "name": "mode",
          "logical_type": "enum:work|design"
        },
        {
          "name": "payload_digest",
          "logical_type": "digest"
        },
        {
          "name": "received_at",
          "logical_type": "utc"
        },
        {
          "name": "external_message_id",
          "logical_type": "nullable:string"
        }
      ],
      "constraints": [
        "UNIQUE(scope, external_message_id) WHERE external_message_id IS NOT NULL"
      ],
      "indexes": [
        "scope,received_at"
      ]
    },
    {
      "name": "resolutions",
      "owner": "GoalService",
      "primary_key": "tenant_id,project_id,resolution_id",
      "columns": [
        {
          "name": "resolution_id",
          "logical_type": "id"
        },
        {
          "name": "intent_id",
          "logical_type": "id"
        },
        {
          "name": "revision",
          "logical_type": "uint"
        },
        {
          "name": "status",
          "logical_type": "enum:resolved|hold|rejected"
        },
        {
          "name": "artifact_digest",
          "logical_type": "digest"
        }
      ],
      "constraints": [
        "UNIQUE(scope,intent_id,revision)"
      ],
      "indexes": [
        "scope,intent_id"
      ]
    },
    {
      "name": "questions",
      "owner": "GoalService",
      "primary_key": "tenant_id,project_id,question_id",
      "columns": [
        {
          "name": "question_id",
          "logical_type": "id"
        },
        {
          "name": "goal_id",
          "logical_type": "id"
        },
        {
          "name": "contract_digest",
          "logical_type": "digest"
        },
        {
          "name": "status",
          "logical_type": "enum:open|answered|superseded|expired"
        },
        {
          "name": "question_digest",
          "logical_type": "digest"
        },
        {
          "name": "answer_digest",

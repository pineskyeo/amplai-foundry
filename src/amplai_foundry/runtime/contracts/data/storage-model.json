        {
          "name": "goal_id",
          "logical_type": "id"
        },
        {
          "name": "revision",
          "logical_type": "uint"
        },
        {
          "name": "content_digest",
          "logical_type": "digest"
        },
        {
          "name": "created_at",
          "logical_type": "utc"
        }
      ],
      "constraints": [
        "IMMUTABLE content; UNIQUE(scope,content_digest)"
      ],
      "indexes": [
        "scope,goal_id,revision"
      ]
    },
    {
      "name": "graph_revisions",
      "owner": "DefinitionStore",
      "primary_key": "tenant_id,project_id,graph_id,revision",
      "columns": [
        {
          "name": "graph_id",
          "logical_type": "id"
        },
        {
          "name": "revision",
          "logical_type": "uint"
        },
        {
          "name": "goal_id",
          "logical_type": "id"
        },
        {
          "name": "contract_digest",
          "logical_type": "digest"
        },
        {
          "name": "content_digest",
          "logical_type": "digest"
        }
      ],
      "constraints": [
        "IMMUTABLE content; scoped FK goal revision by digest"
      ],
      "indexes": [
        "scope,goal_id,revision"
      ]
    },
    {
      "name": "goals",
      "owner": "RuntimeService",
      "primary_key": "tenant_id,project_id,goal_id",
      "columns": [
        {
          "name": "goal_id",
          "logical_type": "id"
        },
        {
          "name": "active_contract_revision",
          "logical_type": "uint"
        },
        {
          "name": "active_graph_id",
          "logical_type": "id"
        },
        {
          "name": "active_graph_revision",
          "logical_type": "uint"
        },
        {
          "name": "execution_epoch",
          "logical_type": "uint"
        },
        {
          "name": "status",
          "logical_type": "goal_state"
        },
        {
          "name": "row_version",
          "logical_type": "uint"
        },
        {
          "name": "event_seq",

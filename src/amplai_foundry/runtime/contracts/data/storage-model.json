        },
        {
          "name": "hold_reason",
          "logical_type": "nullable:string"
        }
      ],
      "constraints": [
        "CAS row_version; terminal outcomes retained in goal revision execution journal"
      ],
      "indexes": [
        "scope,status"
      ]
    },
    {
      "name": "works",
      "owner": "RuntimeService",
      "primary_key": "tenant_id,project_id,work_id",
      "columns": [
        {
          "name": "work_id",
          "logical_type": "id"
        },
        {
          "name": "goal_id",
          "logical_type": "id"
        },
        {
          "name": "graph_id",
          "logical_type": "id"
        },
        {
          "name": "graph_revision",
          "logical_type": "uint"
        },
        {
          "name": "node_id",
          "logical_type": "id"
        },
        {
          "name": "status",
          "logical_type": "work_state"
        },
        {
          "name": "attempt_count",
          "logical_type": "uint"
        },
        {
          "name": "not_before",
          "logical_type": "nullable:utc"
        },
        {
          "name": "priority",
          "logical_type": "int"
        },
        {
          "name": "row_version",
          "logical_type": "uint"
        },
        {
          "name": "event_seq",
          "logical_type": "uint"
        }
      ],
      "constraints": [
        "UNIQUE(scope,graph_id,graph_revision,node_id)"
      ],
      "indexes": [
        "scope,status,not_before,priority,work_id"
      ]
    },
    {
      "name": "runs",
      "owner": "RuntimeService",
      "primary_key": "tenant_id,project_id,run_id",
      "columns": [
        {
          "name": "run_id",
          "logical_type": "id"
        },
        {
          "name": "root_goal_id",
          "logical_type": "id"
        },
        {
          "name": "parent_run_id",
          "logical_type": "nullable:id"
        },
        {
          "name": "work_id",
          "logical_type": "id"
        },
        {
          "name": "attempt",
          "logical_type": "uint"
        },
        {
          "name": "status",
          "logical_type": "run_state"
        },
        {
          "name": "contract_digest",
          "logical_type": "digest"
        },
        {
          "name": "graph_digest",
          "logical_type": "digest"
        },
        {
          "name": "composition_digest",
          "logical_type": "digest"
        },
        {
          "name": "context_digest",
          "logical_type": "digest"
        },
        {
          "name": "usage_digest",
          "logical_type": "nullable:digest"
        },
        {
          "name": "started_at",
          "logical_type": "utc"
        },
        {
          "name": "finished_at",
          "logical_type": "nullable:utc"
        },
        {
          "name": "row_version",
          "logical_type": "uint"
        },
        {
          "name": "event_seq",
          "logical_type": "uint"
        }
      ],
      "constraints": [
        "UNIQUE(scope,work_id,attempt)"
      ],
      "indexes": [
        "scope,status,started_at"
      ]
    },
    {
      "name": "leases",
      "owner": "RuntimeService",
      "primary_key": "tenant_id,project_id,lease_id",
      "columns": [
        {
          "name": "lease_id",
          "logical_type": "id"
        },
        {
          "name": "work_id",
          "logical_type": "id"
        },
        {
          "name": "run_id",
          "logical_type": "id"
        },
        {
          "name": "owner_worker_id",
          "logical_type": "id"
        },
        {
          "name": "owner_epoch",
          "logical_type": "uint"
        },
        {
          "name": "fencing_token",
          "logical_type": "uint"
        },
        {
          "name": "status",
          "logical_type": "enum:active|expired|released|revoked"
        },
        {
          "name": "expires_at",
          "logical_type": "utc"
        },
        {
          "name": "last_heartbeat_at",
          "logical_type": "utc"
        }
      ],
      "constraints": [
        "UNIQUE active lease(scope,work_id) WHERE status=active",
        "monotonic fencing never reset on recovery"
      ],
      "indexes": [
        "scope,status,expires_at"
      ]
    },
    {
      "name": "reservations",
      "owner": "BudgetService",
      "primary_key": "tenant_id,project_id,reservation_id",
      "columns": [
        {
          "name": "reservation_id",
          "logical_type": "id"
        },
        {
          "name": "root_goal_id",
          "logical_type": "id"
        },
        {
          "name": "run_id",
          "logical_type": "id"
        },
        {
          "name": "reserved_tokens",
          "logical_type": "uint"
        },
        {
          "name": "reserved_cost_microunits",
          "logical_type": "nullable:uint"
        },
        {
          "name": "used_tokens",
          "logical_type": "nullable:uint"
        },
        {
          "name": "used_cost_microunits",
          "logical_type": "nullable:uint"
        },
        {
          "name": "usage_status",
          "logical_type": "enum:measured|estimated|unknown"
        },
        {
          "name": "state",
          "logical_type": "enum:open|reconciled|released"
        },
        {
          "name": "row_version",
          "logical_type": "uint"
        }
      ],
      "constraints": [
        "root reservation check inside claim transaction",
        "unknown usage cannot release entire reserve as zero"
      ],
      "indexes": [
        "scope,root_goal_id,state"
      ]
    },
    {
      "name": "resource_claims",
      "owner": "ResourceService",
      "primary_key": "tenant_id,project_id,claim_id",
      "columns": [
        {
          "name": "claim_id",
          "logical_type": "id"
        },
        {
          "name": "resource_key",
          "logical_type": "string"
        },
        {
          "name": "run_id",
          "logical_type": "id"
        },
        {
          "name": "lease_id",
          "logical_type": "id"
        },
        {
          "name": "mode",
          "logical_type": "enum:shared_read|exclusive_write"
        },
        {
          "name": "state",
          "logical_type": "enum:active|quarantine|released"
        }
      ],
      "constraints": [
        "exclusive_write unique active or quarantine resource",
        "read/write compatibility check under same tx"
      ],
      "indexes": [
        "scope,resource_key,state"
      ]
    },
    {
      "name": "steering_events",

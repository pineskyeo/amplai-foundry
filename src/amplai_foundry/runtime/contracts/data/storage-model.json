        {
          "name": "row_version",
          "logical_type": "uint"
        }
      ],
      "constraints": [],
      "indexes": [
        "scope,goal_id,status"
      ]
    },
    {
      "name": "goal_revisions",
      "owner": "DefinitionStore",
      "primary_key": "tenant_id,project_id,goal_id,revision",

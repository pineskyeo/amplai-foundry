{
  "version": "3.0.0",
  "style": "typed ports, application services, unit-of-work; signatures are design pseudocode",
  "interfaces": [
    {
      "owner": "GoalService",
      "signature": "ResolveIntent(intent_ref,ActorContext) -> Resolution; FreezeContract(draft_ref,expected_revision) -> ContractRef",
      "dependencies": [
        "ContextPort",
        "AppRegistry",
        "ContractCompiler",
        "AuthorityPort"
      ],
      "proposed_target": "src/amplai_foundry/runtime/goals/"
    },
    {
      "owner": "ContractCompiler",
      "signature": "ValidateDraft(draft,source_manifest) -> Findings; Freeze(validated_draft) -> immutable ref",
      "dependencies": [
        "SchemaRegistry",
        "SemanticValidators"
      ],
      "proposed_target": "src/amplai_foundry/runtime/contracts/"
    },
    {
      "owner": "GraphCompiler",
      "signature": "Compile(contract_ref,plan_draft,registry_snapshot) -> WorkGraphIR + Report; Replan(old_ref,change) -> new_ref",
      "dependencies": [
        "DefinitionStore",
        "TypedArtifactRegistry"
      ],
      "proposed_target": "src/amplai_foundry/runtime/graphs/"
    },
    {
      "owner": "RuntimeService",
      "signature": "Claim(worker_profile) -> ExecutionEnvelope|NoWork; IngestWorkerEvent(event,lease) -> Ack; Transition(command,expected_version)",
      "dependencies": [
        "UnitOfWork",
        "BudgetPort",
        "AuthorityPort",
        "DriverPort"
      ],
      "proposed_target": "src/amplai_foundry/runtime/execution/"
    },
    {
      "owner": "BudgetService",
      "signature": "Reserve(root,estimate,limits) -> Reservation; Reconcile(usage) -> Balance; Release(known_unused)",
      "dependencies": [
        "RuntimeStore"
      ],
      "proposed_target": "src/amplai_foundry/runtime/budgets/"
    },
    {
      "owner": "EffectService",
      "signature": "Prepare(request,ActorContext) -> Receipt; Dispatch(effect_ref) -> Receipt; Reconcile(effect_ref,probe) -> Receipt",
      "dependencies": [
        "AuthorityPort",
        "ToolBroker",
        "UnitOfWork"
      ],
      "proposed_target": "src/amplai_foundry/runtime/effects/"
    },
    {
      "owner": "ContextService",
      "signature": "Resolve(query,scope,policy) -> SourceRefs; Assemble(contract,mandatory_set,budget) -> ContextBundle",
      "dependencies": [
        "FoundryReadPort",
        "RepoReadPort",
        "OntologyPort"
      ],
      "proposed_target": "src/amplai_foundry/knowledge_runtime/"
    },
    {
      "owner": "EvidenceService",
      "signature": "IngestArtifact(stream,metadata) -> ArtifactRef; AttachEvidence(evidence,verifier_identity) -> EvidenceRef",
      "dependencies": [
        "CAS",
        "VerifierTrustRegistry"
      ],
      "proposed_target": "src/amplai_foundry/runtime/evidence/"
    },
    {
      "owner": "VerifierService",
      "signature": "Execute(plan_ref,subject_refs) -> EvidenceRefs; Decide(criteria,results) -> VerdictRefs; GlobalVerify(goal)",
      "dependencies": [
        "SandboxPort",
        "ArtifactPort",
        "PolicyPort"
      ],
      "proposed_target": "src/amplai_foundry/verification/"
    },
    {
      "owner": "EvaluationService",
      "signature": "FreezeExperiment(plan) -> ExperimentRef; Run(arm,case,repeat) -> RunRef; Analyze(frozen_plan,results) -> EvalReport",
      "dependencies": [
        "RuntimePort",
        "ProtectedCorpusPort",
        "AnalysisPort"
      ],
      "proposed_target": "src/amplai_foundry/evaluation/"
    },
    {
      "owner": "EvolutionService",
      "signature": "Screen(proposal) -> Findings; RequestExperiment -> Command; RequestPromote(report) -> ApprovalRequest",
      "dependencies": [
        "EvaluationPort",
        "AuthorityPort",
        "ReleasePort"
      ],
      "proposed_target": "src/amplai_foundry/meta_harness/"
    },
    {
      "owner": "ReleaseService",
      "signature": "VerifyRelease(ref) -> Report; Promote(plan,grant,expected_pointer) -> Receipt; Rollback(plan,grant) -> Receipt",
      "dependencies": [
        "InstallerPort",
        "AuthorityPort",
        "UnitOfWork"
      ],
      "proposed_target": "src/amplai_foundry/distribution/"
    },
    {
      "owner": "AuthorityAdapter",
      "signature": "Evaluate(action,subject,actor) -> Decision; Consume(grant,effect_key,payload_digest) -> Receipt; SyncRevocations(cursor)",
      "dependencies": [
        "existing governance service API"
      ],
      "proposed_target": "src/amplai_foundry/control_plane/authority_adapter.py"
    },
    {
      "owner": "DriverRegistry",
      "signature": "Probe(profile) -> Capabilities; Qualify(profile,test_report) -> QualificationRef; Select(request) -> PinnedDriver",
      "dependencies": [
        "AgentDriver implementations"
      ],
      "proposed_target": "src/amplai_foundry/agent_drivers/"
    },
    {
      "owner": "OntologyPort",
      "signature": "ResolveTerms(refs,scope) -> Concepts; Validate(mapping,shape_ref) -> Findings",
      "dependencies": [
        "optional domain pack backends"
      ],
      "proposed_target": "src/amplai_foundry/knowledge_runtime/ontology_port.py"
    },
    {
      "owner": "AppInstaller",
      "signature": "Plan(release,binding,current_inventory) -> ChangeSet; DryRun -> Report; Apply(approved_plan) -> Receipt",
      "dependencies": [
        "local filesystem capability",
        "ReleaseRegistry"
      ],
      "proposed_target": "tools/amplai-loop-kit/installer/"
    }
  ]
}

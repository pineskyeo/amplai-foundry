{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/promotion-plan.schema.json",
  "title": "AMPLAI V3 promotion-plan",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "promotion_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "scope": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/scope"
    },
    "expected_active_release_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "candidate_release_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "eval_report_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "target_binding_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "canary_policy_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "abort_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 256
    },
    "rollback_release_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "grant_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "expires_at": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/utc"
    },
    "active_run_policy": {
      "enum": [
        "drain",
        "checkpoint_explicit"
      ]
    }
  },
  "required": [
    "schema_version",
    "promotion_id",
    "scope",
    "expected_active_release_ref",
    "candidate_release_ref",
    "eval_report_ref",
    "target_binding_refs",
    "canary_policy_ref",
    "abort_rules",
    "rollback_release_ref",
    "grant_ref",
    "expires_at",
    "active_run_policy"
  ],
  "additionalProperties": false
}

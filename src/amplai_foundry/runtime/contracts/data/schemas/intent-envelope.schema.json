{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/intent-envelope.schema.json",
  "title": "AMPLAI V3 intent-envelope",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "intent_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "scope": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/scope"
    },
    "actor": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/actor"
    },
    "mode": {
      "enum": [
        "work",
        "design"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "source_channel": {
      "enum": [
        "cli",
        "api",
        "hermes",
        "import"
      ]
    },
    "external_message_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "target_hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 0,
      "maxItems": 256
    },
    "attachment_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/artifact"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "received_at": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/utc"
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    }
  },
  "required": [
    "schema_version",
    "intent_id",
    "scope",
    "actor",
    "mode",
    "text",
    "source_channel",
    "external_message_id",
    "target_hints",
    "attachment_refs",
    "received_at",
    "data_classification"
  ],
  "additionalProperties": false
}

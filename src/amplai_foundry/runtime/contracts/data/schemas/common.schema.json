{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/common.schema.json",
  "title": "AMPLAI shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "tenant_id",
        "project_id"
      ],
      "additionalProperties": false
    },
    "ref": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
        },
        "digest": {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/digest"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "properties": {
        "subject_id": {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
        },
        "kind": {
          "enum": [
            "human",
            "service"
          ]
        },
        "authn_context_ref": {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
        }
      },
      "required": [
        "subject_id",
        "kind",
        "authn_context_ref"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_cost_microunits": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "max_parallel_works": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_delegation_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      },
      "required": [
        "max_wall_seconds",
        "max_attempts",
        "max_tokens",
        "max_cost_microunits",
        "currency",
        "max_parallel_works",
        "max_delegation_depth"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_microunits": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "status": {
          "enum": [
            "measured",
            "estimated",
            "unknown"
          ]
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_microunits",
        "currency",
        "status",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "effect_class": {
          "enum": [
            "pure_read",
            "sandbox_write",
            "external_idempotent_write",
            "external_nonidempotent_write",
            "production_control"
          ]
        }
      },
      "required": [
        "action",
        "resource",
        "effect_class"
      ],
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "origin": {
          "enum": [
            "user_explicit",
            "canonical",
            "observed",
            "inferred"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "status": {
          "enum": [
            "verified",
            "proposed",
            "rejected"
          ]
        },
        "blocks_execution": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "statement",
        "origin",
        "source_refs",
        "status",
        "blocks_execution"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "blocking",
            "critical"
          ]
        },
        "code": {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "id",
        "severity",
        "code",
        "statement",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
        },
        "signed_digest": {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/digest"
        },
        "signature_b64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "algorithm",
        "key_id",
        "signed_digest",
        "signature_b64"
      ],
      "additionalProperties": false
    },
    "gate_result": {
      "type": "object",
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^G-[0-9]{2}$"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "hold",
            "not_applicable"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "gate_id",
        "outcome",
        "evidence_refs",
        "reason"
      ],
      "additionalProperties": false
    },
    "checkpoint_pending": {
      "type": "object",
      "properties": {
        "effect_ref": {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
        },
        "provider_call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "enum": [
            "prepared",
            "dispatched",
            "unknown"
          ]
        }
      },
      "required": [
        "effect_ref",
        "provider_call_id",
        "state"
      ],
      "additionalProperties": false
    }
  }
}

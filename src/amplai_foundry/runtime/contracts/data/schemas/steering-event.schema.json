{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/steering-event.schema.json",
  "title": "AMPLAI V3 steering-event",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "steering_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "scope": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/scope"
    },
    "goal_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "actor": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/actor"
    },
    "expected_contract_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "kind": {
      "enum": [
        "pause",
        "resume",
        "cancel",
        "priority_change",
        "constraint_add",
        "acceptance_change",
        "new_evidence"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "status": {
      "enum": [
        "received",
        "validated",
        "queued",
        "applied",
        "rejected",
        "superseded"
      ]
    },
    "native_turn_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_contract_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "received_at": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/utc"
    }
  },
  "required": [
    "schema_version",
    "steering_id",
    "scope",
    "goal_id",
    "actor",
    "expected_contract_ref",
    "kind",
    "text",
    "evidence_refs",
    "status",
    "native_turn_id",
    "effective_contract_ref",
    "received_at"
  ],
  "additionalProperties": false
}

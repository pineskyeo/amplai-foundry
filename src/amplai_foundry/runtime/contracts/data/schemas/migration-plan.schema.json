{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/migration-plan.schema.json",
  "title": "AMPLAI V3 migration-plan",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "migration_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "scope": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/scope"
    },
    "source_release_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "target_release_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "baseline_inventory_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation_id": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
          },
          "kind": {
            "enum": [
              "keep",
              "move",
              "replace",
              "archive",
              "delete_after_gate",
              "manual_review"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "expected_old_digest": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/digest"
          },
          "replacement_ref": {
            "anyOf": [
              {
                "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "backup_ref": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
          },
          "required_test_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^T-[0-9]{3}$"
            },
            "minItems": 1,
            "maxItems": 256
          },
          "approval_required": {
            "type": "boolean"
          }
        },
        "required": [
          "operation_id",
          "kind",
          "path",
          "expected_old_digest",
          "replacement_ref",
          "backup_ref",
          "required_test_ids",
          "approval_required"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "active_run_policy": {
      "enum": [
        "drain",
        "cancel_reconcile"
      ]
    },
    "rollback_plan_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "dry_run_required": {
      "const": true
    }
  },
  "required": [
    "schema_version",
    "migration_id",
    "scope",
    "source_release_ref",
    "target_release_ref",
    "baseline_inventory_ref",
    "operations",
    "active_run_policy",
    "rollback_plan_ref",
    "dry_run_required"
  ],
  "additionalProperties": false
}

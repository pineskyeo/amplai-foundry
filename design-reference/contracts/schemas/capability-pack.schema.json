{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/capability-pack.schema.json",
  "title": "AMPLAI V3 capability-pack",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "pack_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "publisher": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "protocol_major": {
      "const": 3
    },
    "entry_capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/capability"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "model_requirements": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "context_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "verifier_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "eval_case_ids": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "owned_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 0,
      "maxItems": 256
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "signature": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/signature"
    }
  },
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "publisher",
    "protocol_major",
    "entry_capabilities",
    "dependencies",
    "permissions",
    "model_requirements",
    "context_refs",
    "verifier_refs",
    "eval_case_ids",
    "owned_paths",
    "license",
    "signature"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/eval-report.schema.json",
  "title": "AMPLAI V3 eval-report",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "report_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "scope": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/scope"
    },
    "experiment_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "run_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "analysis_artifact": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/artifact"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "aborted"
      ]
    },
    "safety_gate_results": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/gate_result"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "environment_drifted": {
      "type": "boolean"
    },
    "contamination_findings": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/finding"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 256
    },
    "independent_review_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "issued_at": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/utc"
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "scope",
    "experiment_ref",
    "run_refs",
    "analysis_artifact",
    "verdict",
    "safety_gate_results",
    "environment_drifted",
    "contamination_findings",
    "limitations",
    "independent_review_ref",
    "issued_at"
  ],
  "additionalProperties": false
}

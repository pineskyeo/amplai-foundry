{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/effect-receipt.schema.json",
  "title": "AMPLAI V3 effect-receipt",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "effect_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "scope": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/scope"
    },
    "request_digest": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/digest"
    },
    "state": {
      "enum": [
        "prepared",
        "dispatched",
        "applied",
        "not_applied",
        "unknown",
        "reconciled"
      ]
    },
    "resolved_outcome": {
      "anyOf": [
        {
          "enum": [
            "applied",
            "not_applied"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "external_operation_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "result_artifact": {
      "anyOf": [
        {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "grant_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "policy_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "last_observed_at": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/utc"
    },
    "reconciliation_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "effect_id",
    "scope",
    "request_digest",
    "state",
    "resolved_outcome",
    "external_operation_id",
    "result_artifact",
    "grant_ref",
    "policy_generation",
    "last_observed_at",
    "reconciliation_ref"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "reconciled"
          }
        }
      },
      "then": {
        "properties": {
          "resolved_outcome": {
            "enum": [
              "applied",
              "not_applied"
            ]
          },
          "reconciliation_ref": {
            "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.amplai.invalid/v3/driver-capabilities.schema.json",
  "title": "AMPLAI V3 driver-capabilities",
  "description": "Normative design contract. Structural validation does not establish authorization or runtime correctness.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "driver_id": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
    },
    "driver_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "transport": {
      "enum": [
        "cli",
        "stdio_rpc",
        "http_sse",
        "websocket",
        "managed_api"
      ]
    },
    "environment_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "declared": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "observed": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "qualified": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "qualification_report_ref": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/ref"
    },
    "maturity": {
      "enum": [
        "qualified",
        "experimental",
        "disabled"
      ]
    },
    "probed_at": {
      "$ref": "https://schemas.amplai.invalid/v3/common.schema.json#/$defs/utc"
    }
  },
  "required": [
    "schema_version",
    "driver_id",
    "driver_version",
    "transport",
    "environment_ref",
    "declared",
    "observed",
    "qualified",
    "qualification_report_ref",
    "maturity",
    "probed_at"
  ],
  "additionalProperties": false
}
